    {
      "id": "pd-01-pump-complete",
      "turns": [
        {
          "say": "hút sữa 120ml lúc 10h",
          "model": {
            "i": [
              {
                "k": "pump|meal",
                "f": {
                  "amountMl": 120,
                  "time": "10:00",
                  "dayOffset": 0,
                  "title": "hút sữa"
                },
                "ev": {
                  "amountMl": "120ml",
                  "time": "10h",
                  "title": "hút sữa"
                }
              }
            ]
          }
        }
      ],
      "expect": {
        "outcome": "drafts",
        "kinds": ["pump"],
        "credits": 1
      },
