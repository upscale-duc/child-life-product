{
  "group": "device",
  "note": "Bugs the owner found on a device (2026-10-15/16). Every device bug becomes a case here first; the model replies are what the deployed model returned.",
  "cases": [
    {
      "id": "dev-01-con-dang-ngu",
      "device": "DEV-1",
      "title": "\"Con đang ngủ\" → an ongoing sleep (timer), never an observation stuck in review",
      "turns": [
        {
          "say": "Con đang ngủ",
          "model": {
            "i": [
              {
                "k": "observation",
                "f": {
                  "observation": "sleep"
                },
                "ev": {
                  "observation": "đang ngủ"
                },
                "miss": ["time"]
              }
            ]
          }
        }
      ],
      "expect": {
        "outcome": "drafts",
        "kinds": [["sleep"], ["timer"]],
        "ready": true,
        "credits": 1
      },
      "group": "device"
    },
    {
      "id": "dev-01b-con-dang-ngu-v4",
      "device": "DEV-1",
      "title": "Same message, the reply a v4 model gives (sleep, phase start)",
      "turns": [
        {
          "say": "Con đang ngủ",
          "model": {
            "i": [
              {
                "k": "sleep|observation",
                "f": {
                  "phase": "start",
                  "observation": null
                },
                "ev": {
                  "phase": "đang ngủ"
                }
              }
            ]
          }
        }
      ],
      "expect": {
        "outcome": "drafts",
        "kinds": [["sleep"], ["timer"]],
        "ready": true,
        "credits": 1
      },
      "group": "device"
    },
    {
