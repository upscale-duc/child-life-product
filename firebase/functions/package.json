{
  "name": "child-life-functions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node scripts/build-deploy.mjs",
    "build:deploy": "pnpm --filter @child-life/contracts run build && pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@child-life/contracts": "workspace:*",
    "archiver": "8.0.0",
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/archiver": "8.0.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
