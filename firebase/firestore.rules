rules_version = '2';

// Deny by default. Collections are opened explicitly, per role (business map §5).
// Admin SDK paths (Functions) bypass these rules and are tested separately.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function memberDoc(babyId) {
      return /databases/$(database)/documents/babies/$(babyId)/members/$(request.auth.uid);
    }

    // Active membership of the caller on a baby (role per baby, R-021). An access end date
    // ("Thời hạn", R-024) that has passed denies at once, before the hourly expiry job (P-005).
    function activeMember(babyId) {
      return signedIn() && exists(memberDoc(babyId)) && isActive(get(memberDoc(babyId)).data);
    }

    function isActive(member) {
      return member.status == 'active' &&
        (member.get('accessUntilAt', null) == null || member.accessUntilAt > request.time);
    }

    function role(babyId) {
      return get(memberDoc(babyId)).data.role;
    }

    // Writes lock while the profile is being deleted (13l, Q-037); reads stay until the purge.
    function babyOpen(babyId) {
      return get(/databases/$(database)/documents/babies/$(babyId)).data.get('state', 'active') == 'active';
    }

    // Public projections of feature flags and global limits (P-122, D-011).
    // Written only by Functions; readable before sign-in so kill switches apply everywhere.
    match /publicConfig/{docId} {
      allow get: if docId in ['flags', 'limits'];
      allow list, write: if false;
    }

    // Own account document only; written by Functions (createBabyProfile, later profile edits).
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;

      // One document per install: push token for generic family notices (S10, R-120) and the
      // "Thiết bị đang đăng nhập" list (13n). Only Functions set `signedOutAt` (remote sign-out).
      match /devices/{deviceId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid &&
          deviceId.matches('^d_[a-f0-9]{32}$') && validDevice(request.resource.data) &&
          !('signedOutAt' in request.resource.data);
        allow update: if signedIn() && request.auth.uid == uid &&
          validDevice(request.resource.data) &&
          request.resource.data.get('signedOutAt', null) == resource.data.get('signedOutAt', null);
      }

      // "Đã chia sẻ ra ngoài" (14m): my links and cards, kept by Functions (S13).
      match /sharedOut/{id} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }

      // "Thông báo" (G-056): which pushes this account receives.
      match /settings/{docId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if signedIn() && request.auth.uid == uid && docId == 'notifications' &&
          request.resource.data.keys().hasOnly(['memories', 'messages', 'reminders', 'storage', 'updatedAt']) &&
          request.resource.data.memories is bool && request.resource.data.messages is bool &&
          request.resource.data.reminders is bool && request.resource.data.storage is bool &&
          request.resource.data.updatedAt == request.time;
      }
    }

    function validDevice(d) {
      return d.keys().hasOnly(['token', 'platform', 'language', 'name', 'appVersion', 'updatedAt', 'signedOutAt']) &&
        (!('token' in d) || (d.token is string && d.token.size() <= 4096)) &&
        d.platform in ['ios', 'android'] &&
        d.language in ['vi', 'en'] &&
        (!('name' in d) || (d.name is string && d.name.size() <= 80)) &&
        (!('appVersion' in d) || (d.appVersion is string && d.appVersion.size() <= 32)) &&
        d.updatedAt == request.time;
    }

    // Deletion jobs (13l, 13n): the requester follows "Đang xoá…" until the purge is verified.
    match /deletionJobs/{jobId} {
      allow get: if signedIn() && resource.data.requestedBy == request.auth.uid;
      allow list, write: if false;
    }

    // Exports (R-187): the requester sees their own jobs; files are read through Storage Rules.
    match /dataJobs/{jobId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Family = ownership + quota container (P-001). Owner only until storage views (S11, P-003).
    match /families/{familyId} {
      allow get: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow list, write: if false;
    }

    // Member-visible profile: nickname, avatar ref, trackers, time zone ("Người thân chỉ thấy
    // tên thân mật", R-009). All writes go through Functions in S2.
    match /babies/{babyId} {
      allow get: if activeMember(babyId);
      allow list, write: if false;

      // DOB and gender: Cùng nuôi, or relatives granted "Thông tin bé" (§5, 121:11672).
      // Caregivers never see the full profile.
      match /restricted/{docId} {
        allow get: if docId == 'profile' && activeMember(babyId) && (
          role(babyId) == 'coParent' ||
          (role(babyId) == 'relative' && get(memberDoc(babyId)).data.get('extraRights', {}).get('viewBabyInfo', false) == true)
        );
        allow list, write: if false;
      }

      // Family list (14a): every active member sees who cares for the baby (view only for
      // caregivers and relatives, §5); one's own membership stays readable after removal (R-025).
      match /members/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || activeMember(babyId));
        allow list: if activeMember(babyId);
        allow write: if false;
      }

      // "Đang chờ nhận lời" (14a): pending invites, Cùng nuôi only. Written by Functions.
      match /pendingInvites/{inviteId} {
        allow read: if activeMember(babyId) && role(babyId) == 'coParent';
        allow write: if false;
      }

      // Care records (S4). Written directly by the app so the Firestore cache is the offline
      // outbox; client ids make retries idempotent. Never hard-deleted by clients: "Xóa" is a
      // soft delete with undo and a 30-day bin purged by a scheduled job.
      match /records/{recordId} {
        allow read: if canReadCare(babyId);
        allow create: if canLog(babyId) && babyOpen(babyId) && validNewRecord(babyId, recordId);
        allow update: if canLog(babyId) && babyOpen(babyId) && canEditRecord(babyId) && validRecordUpdate();
        allow delete: if false;
      }

      // "Đã ghi hôm nay" per baby-local date, kept by the onCareRecordWrite trigger.
      match /days/{date} {
        allow read: if canReadCare(babyId);
        allow write: if false;
      }

      // Running timers (S5, P-011): one slot per type, shared live ("Cả nhà đang thấy"). The
      // first start owns it; a second device's start is refused and it joins the running one.
      match /timers/{type} {
        allow read: if canReadCare(babyId);
        allow create: if canLog(babyId) && babyOpen(babyId) && validNewTimer(babyId, type);
        allow update: if canLog(babyId) && babyOpen(babyId) && validTimerUpdate();
        allow delete: if canLog(babyId);
      }

      // Overlapping sleeps found by the server (27, R-075); resolved through a callable.
      match /conflicts/{conflictId} {
        allow read: if canReadCare(babyId);
        allow write: if false;
      }

      // Memories (S9). Written by Functions only (upload sessions, processing, batch actions).
      // Cùng nuôi see everything, including uploads in progress and "Đã xoá gần đây"; relatives
      // only published Gia đình memories and ready Gia đình items (D-002, P-035, R-119); caregivers
      // never see Kỷ niệm (12a, 10o).
      match /memories/{memoryId} {
        allow read: if isParent(babyId) || (isRelative(babyId) &&
          resource.data.audience == 'family' && resource.data.state == 'published' &&
          resource.data.deleted == false);
        allow write: if false;
      }

      match /media/{mediaId} {
        allow read: if isParent(babyId) || (isRelative(babyId) &&
          resource.data.effectiveAudience == 'family' && resource.data.status == 'ready' &&
          resource.data.deleted == false);
        // The uploader marks a video "waiting for Wi-Fi" on their device, so the batch notice
        // need not wait for it (P-030, Q-019).
        allow update: if isParent(babyId) && resource.data.createdBy == request.auth.uid &&
          resource.data.status == 'uploading' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clientState']) &&
          request.resource.data.clientState in [null, 'waitingWifi'];
        allow create, delete: if false;
      }

      // The uploader's own batches ("Đã báo cho Bà nội, Ông ngoại", R-115).
      match /uploadBatches/{batchId} {
        allow read: if isParent(babyId) && resource.data.createdBy == request.auth.uid;
        allow write: if false;
      }

      // "Mốc nhà mình đã tạo" (10h3, 10h4, R-105): reusable by every Cùng nuôi.
      match /milestones/{milestoneId} {
        allow read: if isParent(babyId);
        allow create: if isParent(babyId) && babyOpen(babyId) && validNewMilestone(babyId, milestoneId);
        allow update, delete: if false;
      }

      // Family notices (R-120), delivered by Functions.
      match /notifications/{notificationId} {
        allow read, write: if false;
      }

      // Albums (S10, 10d–10e10): written by Functions (membership and effective audience,
      // D-002, P-035). Relatives see shared albums only (11e); caregivers never (12a).
      match /albums/{albumId} {
        allow read: if isParent(babyId) ||
          (isRelative(babyId) && resource.data.audience == 'family');
        allow write: if false;

        match /items/{mediaId} {
          allow read: if isParent(babyId) || (isRelative(babyId) &&
            get(/databases/$(database)/documents/babies/$(babyId)/albums/$(albumId)).data.audience == 'family');
          allow write: if false;
        }
      }

      // "Yêu thích" (R-107): private to each person, only on what they can see.
      match /favorites/{favoriteId} {
        allow read: if seesMemories(babyId) && resource.data.uid == request.auth.uid;
        allow create: if seesMemories(babyId) && babyOpen(babyId) && validFavorite(babyId, favoriteId);
        allow delete: if seesMemories(babyId) && resource.data.uid == request.auth.uid;
        allow update: if false;
      }

      // "Thương" (11c, 11f, 11g): counts for everyone (on the target), names for parents only.
      match /reactions/{reactionId} {
        allow read: if isParent(babyId) ||
          (isRelative(babyId) && resource.data.uid == request.auth.uid);
        allow create: if seesMemories(babyId) && babyOpen(babyId) && validLove(babyId, reactionId);
        allow delete: if seesMemories(babyId) && resource.data.uid == request.auth.uid;
        allow update: if false;
      }

      // "Nhắn ba mẹ" / "Nhắn Mẹ" (D-034): one-way to the parents; the sender reads their own.
      match /messages/{messageId} {
        allow read: if isParent(babyId) ||
          (activeMember(babyId) && resource.data.from == request.auth.uid);
        allow create: if activeMember(babyId) && babyOpen(babyId) && validMessage(babyId, messageId);
        // Parents mark a message read for themselves only.
        allow update: if isParent(babyId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']) &&
          request.resource.data.readBy.diff(resource.data.readBy).affectedKeys()
            .hasOnly([request.auth.uid]) &&
          request.resource.data.readBy[request.auth.uid] == true;
        allow delete: if false;
      }

      // Stories (S12, 14a–14g, 11i). Parents write drafts themselves (one document per story);
      // saving, re-saving and deleting a saved story go through Functions (audience, D-002 photo
      // sharing, one notice — P-091). Relatives read saved Gia đình stories; caregivers never.
      match /stories/{storyId} {
        allow read: if (isParent(babyId) && (resource.data.status == 'saved' ||
            resource.data.createdBy in [request.auth.uid, 'ai'])) ||
          (isRelative(babyId) && resource.data.status == 'saved' &&
            resource.data.audience == 'family');
        allow create: if isParent(babyId) && babyOpen(babyId) && validNewStory(babyId, storyId);
        allow update: if isParent(babyId) && babyOpen(babyId) && validStoryEdit();
        allow delete: if isParent(babyId) && resource.data.status == 'draft' &&
          resource.data.createdBy in [request.auth.uid, 'ai'];
      }

      // Reminders (S7, 8a–8e, 12f). Cùng nuôi create, edit and delete (D-030, D-031); caregivers
      // view and mark done; relatives never see them (D-018). Notifications are local to the
      // device in notifyDevice (R-091); any viewer may move it to their own device (D-029).
      match /reminders/{reminderId} {
        allow read: if canSeeReminders(babyId);
        allow create: if canSeeReminders(babyId) && role(babyId) == 'coParent' && babyOpen(babyId) &&
          validNewReminder(babyId, reminderId);
        allow update: if canSeeReminders(babyId) && babyOpen(babyId) && validReminderUpdate(babyId);
        allow delete: if canSeeReminders(babyId) && role(babyId) == 'coParent';
      }

      // Rule reminders (v1.0 1a–1h, D-051): read like reminders; written only by the
      // Functions (saveRuleReminder, setRuleReminderEnabled, deleteRuleReminder,
      // answerRuleReminder) and the scheduler, which keep the schedule and recipients valid.
      match /reminderRules/{ruleId} {
        allow read: if canSeeReminders(babyId);
        allow write: if false;
        match /occurrences/{occurrenceId} {
          allow read: if canSeeReminders(babyId);
          allow write: if false;
        }
      }
    }

    // ---------- Care (S4) ----------

    // Cùng nuôi and Người chăm sóc see care; relatives only with "Chăm sóc hằng ngày" (D-018).
    function canReadCare(babyId) {
      return activeMember(babyId) && (
        role(babyId) in ['coParent', 'caregiver'] ||
        get(memberDoc(babyId)).data.get('extraRights', {}).get('viewDailyCare', false) == true
      );
    }

    // Relatives never log (12a, 7b: no "+").
    function canLog(babyId) {
      return activeMember(babyId) && role(babyId) in ['coParent', 'caregiver'];
    }

    // Q-012 → D-022: any Cùng nuôi edits or deletes any record; a caregiver only their own
    // ("Bản ghi của ba mẹ: chỉ xem", 12a).
    function canEditRecord(babyId) {
      return role(babyId) == 'coParent' || resource.data.createdBy == request.auth.uid;
    }

    function notFuture(ts) {
      return ts is timestamp && ts <= request.time + duration.value(5, 'm');
    }

    function intIn(v, lo, hi) {
      return v is int && v >= lo && v <= hi;
    }

    function numIn(v, lo, hi) {
      return (v is int || v is float) && v >= lo && v <= hi;
    }

    function optionalDuration(x) {
      return x.durationMin == null || intIn(x.durationMin, 1, 240);
    }

    // Shapes and ranges mirror packages/contracts/src/care.ts.
    function validCareData(type, x) {
      return (type == 'bottle' && x.keys().hasOnly(['amountMl', 'milk']) &&
          x.keys().hasAll(['amountMl', 'milk']) &&
          (x.amountMl == null || intIn(x.amountMl, 1, 500)) &&
          x.milk in ['breastMilk', 'formula']) ||
        (type == 'breast' &&
          x.keys().hasOnly(['side', 'durationMin', 'leftMin', 'rightMin', 'endSide']) &&
          x.keys().hasAll(['side', 'durationMin']) &&
          x.side in ['left', 'right', 'both'] && optionalDuration(x) &&
          (x.get('leftMin', null) == null || intIn(x.leftMin, 0, 240)) &&
          (x.get('rightMin', null) == null || intIn(x.rightMin, 0, 240)) &&
          x.get('endSide', null) in [null, 'left', 'right']) ||
        (type == 'sleep' && x.keys().size() == 0) ||
        (type == 'pump' && x.keys().hasOnly(['side', 'amountMl', 'durationMin']) &&
          x.keys().hasAll(['side', 'amountMl', 'durationMin']) &&
          x.side in ['left', 'right', 'both'] && intIn(x.amountMl, 1, 1000) &&
          optionalDuration(x)) ||
        (type == 'diaper' && x.keys().hasOnly(['kind']) &&
          x.kind in ['wet', 'dirty', 'both']) ||
        (type == 'growth' && x.keys().hasOnly(['weightKg', 'lengthCm', 'measuredOn']) &&
          x.keys().hasAll(['weightKg', 'lengthCm', 'measuredOn']) &&
          numIn(x.weightKg, 0.3, 40) &&
          (x.lengthCm == null || numIn(x.lengthCm, 20, 150)) &&
          x.measuredOn is string && x.measuredOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    // When it happened: no future times (G-021, 5 min of clock skew); spans end after they start.
    function validCareBody(d) {
      return d.type in ['bottle', 'breast', 'pump', 'sleep', 'diaper', 'growth'] &&
        notFuture(d.occurredAt) &&
        (d.endedAt == null || (notFuture(d.endedAt) && d.endedAt >= d.occurredAt)) &&
        // A sleep always has an end (a running one is a timer) and lasts at most 24 h.
        (d.type != 'sleep' || (d.endedAt != null &&
          d.endedAt <= d.occurredAt + duration.value(24, 'h'))) &&
        d.data is map && validCareData(d.type, d.data);
    }

    function validNewRecord(babyId, recordId) {
      let d = request.resource.data;
      let me = get(memberDoc(babyId)).data;
      return d.keys().hasOnly(['id', 'babyId', 'type', 'occurredAt', 'endedAt', 'data',
          'createdBy', 'author', 'createdAt', 'clientCreatedAt', 'updatedAt', 'updatedBy',
          'deleted', 'deletedAt', 'deletedBy', 'source']) &&
        d.keys().hasAll(['id', 'babyId', 'type', 'occurredAt', 'endedAt', 'data', 'createdBy',
          'author', 'createdAt', 'clientCreatedAt', 'updatedAt', 'updatedBy', 'deleted',
          'deletedAt', 'deletedBy', 'source']) &&
        recordId.matches('^r_[a-f0-9]{32}$') && d.id == recordId && d.babyId == babyId &&
        d.createdBy == request.auth.uid && d.updatedBy == request.auth.uid &&
        d.createdAt == request.time && d.updatedAt == request.time &&
        d.clientCreatedAt is timestamp &&
        d.deleted == false && d.deletedAt == null && d.deletedBy == null &&
        d.source == 'app' &&
        // "Mẹ ghi" / "Cô Lan ghi" (D-024) must be the writer's own membership.
        d.author is map && d.author.keys().hasOnly(['name', 'relation', 'relationCustom']) &&
        d.author.name == me.displayName && d.author.relation == me.relation &&
        d.author.relationCustom == me.get('relationCustom', null) &&
        validCareBody(d);
    }

    // ---------- Timers (S5) ----------

    function validSide(s) {
      return s is map && s.keys().hasOnly(['accumulatedMs', 'runningSince']) &&
        s.keys().hasAll(['accumulatedMs', 'runningSince']) &&
        s.accumulatedMs is int && s.accumulatedMs >= 0 &&
        (s.runningSince == null || notFuture(s.runningSince));
    }

    function validTimerBody(d) {
      return notFuture(d.startedAt) &&
        d.paused is bool && d.pausedSides is list && d.pausedSides.size() <= 2 &&
        ((d.type == 'sleep' && d.sides == null) ||
          (d.type in ['breast', 'pump'] && d.sides is map &&
            d.sides.keys().hasOnly(['left', 'right']) &&
            d.sides.keys().hasAll(['left', 'right']) &&
            validSide(d.sides.left) && validSide(d.sides.right)));
    }

    function validNewTimer(babyId, type) {
      let d = request.resource.data;
      let me = get(memberDoc(babyId)).data;
      return type in ['sleep', 'breast', 'pump'] && d.type == type && d.babyId == babyId &&
        d.keys().hasOnly(['type', 'babyId', 'sessionId', 'startedAt', 'startedBy', 'author',
          'sides', 'paused', 'pausedSides', 'updatedAt', 'updatedBy']) &&
        d.keys().hasAll(['type', 'babyId', 'sessionId', 'startedAt', 'startedBy', 'author',
          'sides', 'paused', 'pausedSides', 'updatedAt', 'updatedBy']) &&
        d.sessionId is string && d.sessionId.matches('^[a-f0-9]{32}$') &&
        d.startedBy == request.auth.uid && d.updatedBy == request.auth.uid &&
        d.updatedAt == request.time &&
        d.author is map && d.author.keys().hasOnly(['name', 'relation', 'relationCustom']) &&
        d.author.name == me.displayName && d.author.relation == me.relation &&
        d.author.relationCustom == me.get('relationCustom', null) &&
        validTimerBody(d);
    }

    // Pause, switch side, edit start: the session itself never changes hands.
    function validTimerUpdate() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys()
          .hasOnly(['startedAt', 'sides', 'paused', 'pausedSides', 'updatedAt', 'updatedBy']) &&
        d.updatedBy == request.auth.uid && d.updatedAt == request.time &&
        validTimerBody(d);
    }

    function validRecordUpdate() {
      let d = request.resource.data;
      let o = resource.data;
      let changed = d.diff(o).affectedKeys();
      let deleteKeys = ['deleted', 'deletedAt', 'deletedBy', 'updatedAt', 'updatedBy'];
      return d.updatedBy == request.auth.uid && d.updatedAt == request.time && (
        // "Sửa": time and details only.
        (o.deleted == false && d.deleted == false &&
          changed.hasOnly(['occurredAt', 'endedAt', 'data', 'updatedAt', 'updatedBy']) &&
          validCareBody(d)) ||
        // "Xóa bản ghi" → soft delete.
        (o.deleted == false && d.deleted == true && changed.hasOnly(deleteKeys) &&
          d.deletedAt == request.time && d.deletedBy == request.auth.uid) ||
        // "Hoàn tác" (5 s) or restore from "Đã xoá gần đây".
        (o.deleted == true && d.deleted == false && changed.hasOnly(deleteKeys) &&
          d.deletedAt == null && d.deletedBy == null)
      );
    }

    // ---------- Memories (S9) ----------

    function isParent(babyId) {
      return activeMember(babyId) && role(babyId) == 'coParent';
    }

    function isRelative(babyId) {
      return activeMember(babyId) && role(babyId) == 'relative';
    }

    function validNewMilestone(babyId, milestoneId) {
      let d = request.resource.data;
      let me = get(memberDoc(babyId)).data;
      return milestoneId.matches('^ms_[a-f0-9]{32}$') &&
        d.keys().hasOnly(['id', 'babyId', 'name', 'date', 'createdBy', 'author', 'createdAt']) &&
        d.keys().hasAll(['id', 'babyId', 'name', 'date', 'createdBy', 'author', 'createdAt']) &&
        d.id == milestoneId && d.babyId == babyId && d.createdBy == request.auth.uid &&
        d.createdAt == request.time && ownAuthor(d.author, me) &&
        d.name is string && d.name.trim().size() >= 1 && d.name.size() <= 60 &&
        d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // ---------- Albums, favourites, loves, messages (S10) ----------

    function seesMemories(babyId) {
      return isParent(babyId) || isRelative(babyId);
    }

    function babyDoc(babyId, collection, id) {
      return get(/databases/$(database)/documents/babies/$(babyId)/$(collection)/$(id)).data;
    }

    // What a relative may act on: published, shared, not deleted (R-119).
    function targetShared(babyId, target, targetId) {
      return (target == 'media' && babyDoc(babyId, 'media', targetId).effectiveAudience == 'family' &&
          babyDoc(babyId, 'media', targetId).status == 'ready' &&
          babyDoc(babyId, 'media', targetId).deleted == false) ||
        (target == 'memory' && babyDoc(babyId, 'memories', targetId).audience == 'family' &&
          babyDoc(babyId, 'memories', targetId).state == 'published' &&
          babyDoc(babyId, 'memories', targetId).deleted == false) ||
        (target == 'album' && babyDoc(babyId, 'albums', targetId).audience == 'family') ||
        (target == 'story' && babyDoc(babyId, 'stories', targetId).audience == 'family' &&
          babyDoc(babyId, 'stories', targetId).status == 'saved');
    }

    function validStoryContent(d) {
      return d.title is string && d.title.size() <= 120 &&
        (d.coverMediaId == null || d.coverMediaId is string) &&
        d.blocks is list && d.blocks.size() <= 40 &&
        d.kind in ['story', 'letter'] &&
        d.audience in ['parents', 'family'];
    }

    function validNewStory(babyId, storyId) {
      let d = request.resource.data;
      return storyId.matches('^sto_[a-f0-9]{32}$') && d.id == storyId && d.babyId == babyId &&
        d.keys().hasOnly(['id', 'babyId', 'kind', 'origin', 'suggestion', 'status', 'title',
          'coverMediaId', 'blocks', 'audience', 'createdBy', 'author', 'loveCount', 'createdAt',
          'updatedAt', 'updatedBy']) &&
        d.origin == 'manual' && d.suggestion == false && d.status == 'draft' &&
        d.createdBy == request.auth.uid && d.updatedBy == request.auth.uid &&
        d.loveCount == 0 && d.author is map &&
        d.createdAt == request.time && d.updatedAt == request.time &&
        validStoryContent(d);
    }

    // Content edits only; a suggestion becomes the editor's draft ("Lưu nháp"). Status, audience
    // of a saved story and the shared photo list stay with Functions.
    function validStoryEdit() {
      let d = request.resource.data;
      let o = resource.data;
      let changed = d.diff(o).affectedKeys();
      return changed.hasOnly(['title', 'coverMediaId', 'blocks', 'kind', 'audience', 'suggestion',
          'createdBy', 'author', 'updatedAt', 'updatedBy']) &&
        d.updatedAt == request.time && d.updatedBy == request.auth.uid &&
        (o.createdBy == request.auth.uid || o.status == 'saved' ||
          (o.createdBy == 'ai' && d.createdBy == request.auth.uid)) &&
        (!changed.hasAny(['createdBy']) || (o.createdBy == 'ai' && d.createdBy == request.auth.uid)) &&
        (!changed.hasAny(['audience']) || o.status == 'draft') &&
        (!changed.hasAny(['suggestion']) || d.suggestion == false) &&
        validStoryContent(d);
    }

    function validFavorite(babyId, favoriteId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'mediaId', 'createdAt']) &&
        d.keys().hasAll(['uid', 'mediaId', 'createdAt']) &&
        d.uid == request.auth.uid && d.createdAt == request.time &&
        d.mediaId is string && favoriteId == request.auth.uid + '__' + d.mediaId &&
        (isParent(babyId) || targetShared(babyId, 'media', d.mediaId));
    }

    function validLove(babyId, reactionId) {
      let d = request.resource.data;
      let me = get(memberDoc(babyId)).data;
      return d.keys().hasOnly(['uid', 'target', 'targetId', 'author', 'createdAt']) &&
        d.keys().hasAll(['uid', 'target', 'targetId', 'author', 'createdAt']) &&
        d.uid == request.auth.uid && d.createdAt == request.time &&
        d.target in ['media', 'memory', 'album', 'story'] && d.targetId is string &&
        reactionId == d.target + '__' + d.targetId + '__' + request.auth.uid &&
        ownAuthor(d.author, me) &&
        (isParent(babyId) || targetShared(babyId, d.target, d.targetId));
    }

    // Relatives write about what they can see; caregivers "Nhắn Mẹ" from a parent's record.
    function validMessage(babyId, messageId) {
      let d = request.resource.data;
      let me = get(memberDoc(babyId)).data;
      return messageId.matches('^msg_[a-f0-9]{32}$') &&
        d.keys().hasOnly(['id', 'babyId', 'from', 'author', 'context', 'text', 'createdAt', 'readBy']) &&
        d.keys().hasAll(['id', 'babyId', 'from', 'author', 'context', 'text', 'createdAt', 'readBy']) &&
        d.id == messageId && d.babyId == babyId && d.from == request.auth.uid &&
        d.createdAt == request.time && d.readBy == {} && ownAuthor(d.author, me) &&
        d.text is string && d.text.trim().size() >= 1 && d.text.size() <= 1000 &&
        d.context is map && d.context.keys().hasOnly(['kind', 'id']) && d.context.id is string &&
        ((me.role == 'relative' && d.context.kind in ['media', 'memory', 'album', 'story'] &&
            targetShared(babyId, d.context.kind, d.context.id)) ||
          (me.role == 'caregiver' && d.context.kind == 'record'));
    }

    // ---------- Reminders (S7) ----------

    function canSeeReminders(babyId) {
      return activeMember(babyId) && role(babyId) in ['coParent', 'caregiver'];
    }

    function ownAuthor(a, me) {
      return a is map && a.keys().hasOnly(['name', 'relation', 'relationCustom']) &&
        a.name == me.displayName && a.relation == me.relation &&
        a.relationCustom == me.get('relationCustom', null);
    }

    // "iPhone của Mai": only ever the writer's own device (D-029).
    function ownDevice(n, me) {
      return n == null || (n is map && n.keys().hasOnly(['id', 'uid', 'label', 'owner']) &&
        n.keys().hasAll(['id', 'uid', 'label', 'owner']) &&
        n.id is string && n.id.matches('^d_[a-f0-9]{32}$') &&
        n.uid == request.auth.uid && n.label is string && n.label.size() >= 1 &&
        n.label.size() <= 40 && n.owner == me.displayName);
    }

    // Shapes mirror packages/contracts/src/reminders.ts. The due time is never in the past when
    // it is set (D-031, 5 min of clock skew) and at most a year ahead.
    function validReminderFields(d, dueChanged) {
      return d.title is string && d.title.size() >= 1 && d.title.size() <= 80 &&
        d.title.trim().size() >= 1 &&
        d.dueAt is timestamp && d.dueAt <= request.time + duration.value(366, 'd') &&
        (!dueChanged || d.dueAt >= request.time - duration.value(5, 'm')) &&
        d.leadMinutes in [0, 10, 30, 60, 120, 1440];
    }

    function validNewReminder(babyId, reminderId) {
      let d = request.resource.data;
      let me = get(memberDoc(babyId)).data;
      return d.keys().hasOnly(['id', 'babyId', 'title', 'dueAt', 'leadMinutes', 'notifyDevice',
          'createdBy', 'author', 'createdAt', 'updatedAt', 'updatedBy', 'done', 'doneAt',
          'doneBy', 'doneAuthor']) &&
        d.keys().hasAll(['id', 'babyId', 'title', 'dueAt', 'leadMinutes', 'notifyDevice',
          'createdBy', 'author', 'createdAt', 'updatedAt', 'updatedBy', 'done', 'doneAt',
          'doneBy', 'doneAuthor']) &&
        reminderId.matches('^rm_[a-f0-9]{32}$') && d.id == reminderId && d.babyId == babyId &&
        d.createdBy == request.auth.uid && d.updatedBy == request.auth.uid &&
        d.createdAt == request.time && d.updatedAt == request.time &&
        d.done == false && d.doneAt == null && d.doneBy == null && d.doneAuthor == null &&
        ownAuthor(d.author, me) && ownDevice(d.notifyDevice, me) &&
        validReminderFields(d, true);
    }

    function validReminderUpdate(babyId) {
      let d = request.resource.data;
      let o = resource.data;
      let me = get(memberDoc(babyId)).data;
      let changed = d.diff(o).affectedKeys();
      let doneKeys = ['done', 'doneAt', 'doneBy', 'doneAuthor', 'updatedAt', 'updatedBy'];
      return d.updatedBy == request.auth.uid && d.updatedAt == request.time && (
        // "Sửa nhắc việc": Cùng nuôi only (D-031).
        (role(babyId) == 'coParent' &&
          changed.hasOnly(['title', 'dueAt', 'leadMinutes', 'notifyDevice', 'updatedAt',
            'updatedBy']) &&
          (!changed.hasAny(['notifyDevice']) || ownDevice(d.notifyDevice, me)) &&
          validReminderFields(d, changed.hasAny(['dueAt']))) ||
        // "Thông báo" → this device (D-029).
        (changed.hasOnly(['notifyDevice', 'updatedAt', 'updatedBy']) &&
          d.notifyDevice != null && ownDevice(d.notifyDevice, me)) ||
        // "Đánh dấu đã xong" (8e, 12f).
        (o.done == false && d.done == true && changed.hasOnly(doneKeys) &&
          d.doneAt == request.time && d.doneBy == request.auth.uid &&
          ownAuthor(d.doneAuthor, me)) ||
        // Undo (D-030): any Cùng nuôi, or whoever marked it.
        (o.done == true && d.done == false && changed.hasOnly(doneKeys) &&
          d.doneAt == null && d.doneBy == null && d.doneAuthor == null &&
          (role(babyId) == 'coParent' || o.doneBy == request.auth.uid))
      );
    }

    // "My babies": collection-group query on members where uid == me (any status, so the app
    // can show "Bạn không còn quyền xem hồ sơ này", R-025).
    match /{path=**}/members/{uid} {
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
