rules_version = '2';

// Deny by default. Collections are opened explicitly, per role (business map §5).
// Admin SDK paths (Functions) bypass these rules and are tested separately.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function memberDoc(babyId) {
      return /databases/$(database)/documents/babies/$(babyId)/members/$(request.auth.uid);
    }

    // Active membership of the caller on a baby (role per baby, R-021). An access end date
    // ("Thời hạn", R-024) that has passed denies at once, before the hourly expiry job (P-005).
    function activeMember(babyId) {
      return signedIn() && exists(memberDoc(babyId)) && isActive(get(memberDoc(babyId)).data);
    }

    function isActive(member) {
      return member.status == 'active' &&
        (member.get('accessUntilAt', null) == null || member.accessUntilAt > request.time);
    }

    function role(babyId) {
      return get(memberDoc(babyId)).data.role;
    }

    // Writes lock while the profile is being deleted (13l, Q-037); reads stay until the purge.
    function babyOpen(babyId) {
      return get(/databases/$(database)/documents/babies/$(babyId)).data.get('state', 'active') == 'active' &&
        !writeSuspended(babyId);
    }

    // PV44 (D-101 Q-101): a writer the manager left out after a downgrade is view-only until
    // given a seat again. Set only by `chooseFamilyWriteSeats`; members are never removed.
    function writeSuspended(babyId) {
      return signedIn() && exists(memberDoc(babyId)) &&
        get(memberDoc(babyId)).data.get('writeSuspended', false) == true;
    }

    // Public projections of feature flags and global limits (P-122, D-011).
    // Written only by Functions; readable before sign-in so kill switches apply everywhere.
    // Approved reference tables (P-138: WHO growth, bottle quick picks, vaccine schedule), the same
    // way: published by Functions after a second person approves; the app falls back to its copy.
    match /publicConfig/{docId} {
      allow get: if docId in ['flags', 'limits', 'reference_growth_weight', 'reference_growth_length',
        'reference_bottle', 'reference_vaccines', 'content_firstAid', 'appUpdate', 'keepsakes',
        'rhythm_reference', 'content_rhythm', 'printStudio'];
      allow list, write: if false;
    }
    match /printReviewsPublic/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Editorial content (D-076 #5–#7): Thư viện chăm bé articles, "Giai đoạn của bé" stage content
    // and reference Mốc phát triển. Published by staff callables after a second person approves;
    // signed-in users read published documents only (lists must filter status == 'published').
    // Drafts (contentDrafts) are staff-only through callables: the catch-all below denies them.
    match /contentArticles/{id} {
      allow read: if signedIn() && resource.data.status == 'published';
      allow write: if false;
    }
    match /contentStages/{id} {
      allow read: if signedIn() && resource.data.status == 'published';
      allow write: if false;
    }
    match /contentMilestones/{id} {
      allow read: if signedIn() && resource.data.status == 'published';
      allow write: if false;
    }
    // Dinh dưỡng theo giai đoạn (D-083): stages, micronutrients and suggestion rules, the same way.
    match /contentNutritionStages/{id} {
      allow read: if signedIn() && resource.data.status == 'published';
      allow write: if false;
    }
    match /contentNutrients/{id} {
      allow read: if signedIn() && resource.data.status == 'published';
      allow write: if false;
    }
    match /contentNutritionRules/{id} {
      allow read: if signedIn() && resource.data.status == 'published';
      allow write: if false;
    }
    // Ăn dặm (D-085): the food catalogue and recipes, the same way.
    match /contentFoods/{id} {
      allow read: if signedIn() && resource.data.status == 'published';
      allow write: if false;
    }
    match /contentRecipes/{id} {
      allow read: if signedIn() && resource.data.status == 'published';
      allow write: if false;
    }

    // Own account document only; written by Functions (createBabyProfile, later profile edits).
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;

      // One document per install: push token for generic family notices (S10, R-120) and the
      // "Thiết bị đang đăng nhập" list (13n). Only Functions set `signedOutAt` (remote sign-out).
      match /devices/{deviceId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid &&
          deviceId.matches('^d_[a-f0-9]{32}$') && validDevice(request.resource.data) &&
          !('signedOutAt' in request.resource.data);
        allow update: if signedIn() && request.auth.uid == uid &&
          validDevice(request.resource.data) &&
          request.resource.data.get('signedOutAt', null) == resource.data.get('signedOutAt', null);
      }

      // "Đã chia sẻ ra ngoài" (14m): my links and cards, kept by Functions (S13).
      match /sharedOut/{id} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }

      // Hộp thông báo (EN06, D-076 #2): written only by Functions (one row per push). The owner
      // reads and may only mark a row read or archived, once, at the request time. The platform
      // ledger, stats, templates and ops switches (`notificationDeliveries`, `notificationStats`,
      // `notificationTemplates`, `config/notifications`, P-174) have no client access at all: they
      // fall to the deny-all at the end of this file.
      match /notifications/{id} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, delete: if false;
        allow update: if signedIn() && request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt', 'archivedAt']) &&
          (request.resource.data.readAt == resource.data.readAt ||
            (resource.data.readAt == null && request.resource.data.readAt == request.time)) &&
          (request.resource.data.archivedAt == resource.data.archivedAt ||
            (resource.data.archivedAt == null && request.resource.data.archivedAt == request.time));
      }

      // Thư viện chăm bé "Đã lưu" (4e / 4f, D-076 #7): the articles this person saved, per person
      // (not per baby or family). Only the article id (the doc id), when it was saved and the
      // revision last read (the 4f "đã được cập nhật" banner); nothing about a child.
      match /savedArticles/{articleId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid &&
          // Guides (`art_…`) and Ăn dặm recipes (`rcp_…`, 5g "Lưu", D-085).
          articleId.matches('^(art_[a-z0-9_]{2,60}|rcp_[a-z0-9_]{2,40})$') &&
          request.resource.data.keys().hasOnly(['savedAt', 'revision']) &&
          request.resource.data.keys().hasAll(['savedAt', 'revision']) &&
          request.resource.data.revision is int && request.resource.data.revision >= 1 &&
          request.resource.data.revision <= 100000 &&
          (request.resource.data.savedAt == request.time ||
            (resource != null && request.resource.data.savedAt == resource.data.savedAt));
      }

      // "Thông báo" (G-056): which pushes this account receives. "firstAid": the situations this
      // account saved in Sơ cứu (D-058), ids only. "ai" (AI consent, NL10, P-151): readable by its
      // owner, written only by the `setAiConsent` callable (no client branch below).
      match /settings/{docId} {
        // ENG-00: private leases, budget/fatigue and consent are served by scoped callables.
        allow read: if signedIn() && request.auth.uid == uid &&
          !(docId in ['engagement', 'engagementState', 'engagementDevice']);
        allow write: if signedIn() && request.auth.uid == uid && ((docId == 'notifications' &&
          validNotificationSettings(request.resource.data)) || (docId == 'firstAid' &&
          request.resource.data.keys().hasOnly(['saved', 'updatedAt']) &&
          request.resource.data.saved is list && request.resource.data.saved.size() <= 40 &&
          request.resource.data.updatedAt == request.time) || (docId == 'keepsakes' &&
          // Thiệp / Video templates this person saved (owner, 2026-10-30), newest first.
          request.resource.data.keys().hasOnly(['saved', 'updatedAt']) &&
          request.resource.data.saved is list && request.resource.data.saved.size() <= 100 &&
          request.resource.data.updatedAt == request.time) || (docId == 'personalization' &&
          validPersonalization(request.resource.data)) || (docId == 'carePlan' &&
          validCarePlanPrefs(request.resource.data)));
      }
      // P-172: server-authored state, bound to its owner AND current baby membership.
      match /personalization/{babyId} {
        allow read: if signedIn() && request.auth.uid == uid && canReadCare(babyId);
        allow write: if false;
      }
      // P-175: this person's Hôm nay for one child (goals, order, pins, hides, AX33 answers).
      // Written by its owner while an active member of the baby; readable and deletable by its
      // owner only (purged with the account or the membership).
      match /experience/{babyId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid && activeMember(babyId) &&
          validExperience(request.resource.data, babyId);
      }

      // Hiểu con (D-151): this person's "Có ích / Chưa có ích" and the kinds they hid, per baby.
      // Purged with the account (recursive) or the baby (collection group on babyId).
      match /insightPrefs/{babyId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid && activeMember(babyId) &&
          !isRelative(babyId) && validInsightPrefs(request.resource.data, babyId);
      }
    }

    // "Thông báo" EN07 (D-076 #2; G-056 keys first): mirrors `notificationSettingsDocSchema`, every
    // switch a bool, any subset (a missing one takes its default).
    function validNotificationSettings(d) {
      let keys = ['memories', 'messages', 'reminders', 'storage', 'vaccines', 'spending', 'rhythm',
        'stages', 'milestones', 'articles', 'weeklySummary', 'photoSuggestions', 'keepsakePrompts',
        'familyActivity', 'familyMembers', 'handovers', 'babyName'];
      return d.keys().hasOnly(keys.concat(['updatedAt'])) && d.updatedAt == request.time &&
        (!('memories' in d) || d.memories is bool) && (!('messages' in d) || d.messages is bool) &&
        (!('reminders' in d) || d.reminders is bool) && (!('storage' in d) || d.storage is bool) &&
        (!('vaccines' in d) || d.vaccines is bool) && (!('spending' in d) || d.spending is bool) &&
        (!('rhythm' in d) || d.rhythm is bool) && (!('stages' in d) || d.stages is bool) &&
        (!('milestones' in d) || d.milestones is bool) && (!('articles' in d) || d.articles is bool) &&
        (!('weeklySummary' in d) || d.weeklySummary is bool) &&
        (!('photoSuggestions' in d) || d.photoSuggestions is bool) &&
        (!('keepsakePrompts' in d) || d.keepsakePrompts is bool) &&
        (!('familyActivity' in d) || d.familyActivity is bool) &&
        (!('familyMembers' in d) || d.familyMembers is bool) &&
        (!('handovers' in d) || d.handovers is bool) &&
        (!('babyName' in d) || d.babyName is bool);
    }

    // Cùng Chăm Con N1 (D-135 Q5): "Nhắc trước" and "Nhắc cả trong giờ yên lặng"; mirrors
    // `carePlanPrefsDocSchema`.
    function validCarePlanPrefs(d) {
      return d.keys().hasOnly(['leadMinutes', 'quietHours', 'team', 'updatedAt']) &&
        d.updatedAt == request.time &&
        (!('leadMinutes' in d) || d.leadMinutes in [0, 5, 10, 15]) &&
        (!('quietHours' in d) || d.quietHours is bool) &&
        (!('team' in d) || d.team is bool);
    }

    // Nhịp lớn lên EN01 / EN02 / EN05 (per person, free): mirrors `userPreferencesSchema`.
    function validPersonalization(d) {
      let interests = ['sleep', 'feeding', 'milestones', 'vaccines', 'nutrition', 'moments'];
      let hhmm = '^([01][0-9]|2[0-3]):[0-5][0-9]$';
      return d.keys().hasOnly(['interests', 'digestTime', 'quietHours', 'fewer', 'updatedAt']) &&
        d.keys().hasAll(['interests', 'digestTime', 'quietHours', 'fewer', 'updatedAt']) &&
        d.interests is list && d.interests.size() <= 6 && d.interests.hasOnly(interests) &&
        d.fewer is list && d.fewer.size() <= 6 && d.fewer.hasOnly(interests) &&
        (d.digestTime == null || (d.digestTime is string && d.digestTime.matches(hhmm))) &&
        (d.quietHours == null || (d.quietHours is map &&
          d.quietHours.keys().hasOnly(['from', 'to']) && d.quietHours.keys().hasAll(['from', 'to']) &&
          d.quietHours.from is string && d.quietHours.from.matches(hhmm) &&
          d.quietHours.to is string && d.quietHours.to.matches(hhmm))) &&
        (d.updatedAt == request.time || d.updatedAt == null ||
          (d.updatedAt is string && d.updatedAt.size() <= 40));
    }

    // P-175 Adaptive Experience (`packages/contracts/src/adaptive.ts` experienceSchema): one
    // person's arrangement of one child's Hôm nay. Ids are the contract's widget and goal ids.
    function validWidgetList(l) {
      // care_duty: P-181 "Ai đang trông bé" (missing here, every save that listed it was refused).
      // insight: Hiểu con · "Điều đáng chú ý" (D-151 #4).
      return l is list && l.size() <= 15 && l.toSet().size() == l.size() &&
        l.hasOnly(['tiles', 'forYou', 'solids', 'reminders', 'quickActions', 'vaccine', 'spending',
          'rhythm', 'recent_memories', 'moment_today', 'create_from_memories', 'growth',
          'family_view', 'care_duty', 'insight']);
    }

    function validInsightPrefs(d, babyId) {
      return d.keys().hasOnly(['babyId', 'muted', 'votes', 'updatedAt']) &&
        d.babyId == babyId &&
        d.muted is list && d.muted.size() <= 3 &&
        d.muted.hasOnly(['night_longest', 'night_total', 'night_feeds']) &&
        d.votes is map && d.votes.size() <= 60 &&
        d.updatedAt == request.time;
    }

    function validExperience(d, babyId) {
      let keys = ['v', 'babyId', 'goals', 'goalsSource', 'bandApplied', 'order', 'pinned', 'shown', 'hidden',
        'stagePrompts', 'updatedAt'];
      return d.keys().hasOnly(keys) && d.keys().hasAll(keys) && d.v == 1 && d.babyId == babyId &&
        d.goals is list && d.goals.size() <= 6 && d.goals.toSet().size() == d.goals.size() &&
        d.goals.hasOnly(['track_care', 'memories', 'growth_vaccines', 'family', 'spending', 'reminders']) &&
        d.goalsSource in ['chosen', 'skipped', 'migrated'] &&
        d.bandApplied in ['b0_1', 'b1_3', 'b3_6', 'b6_12'] &&
        validWidgetList(d.order) && validWidgetList(d.pinned) &&
        validWidgetList(d.shown) && validWidgetList(d.hidden) &&
        d.stagePrompts is map && d.stagePrompts.keys().hasOnly(['m12', 'm36', 'm72']) &&
        d.stagePrompts.values().hasOnly(['applied', 'kept']) &&
        d.updatedAt == request.time;
    }

    // P-137: `lastActiveAt` (once a local day, the analytics heartbeat), `osVersion` and a coarse
    // `model` (never shown with the device name to staff).
    function validDevice(d) {
      return d.keys().hasOnly(['token', 'platform', 'language', 'name', 'appVersion', 'updatedAt', 'signedOutAt',
          'lastActiveAt', 'osVersion', 'model']) &&
        (!('token' in d) || (d.token is string && d.token.size() <= 4096)) &&
        d.platform in ['ios', 'android'] &&
        d.language in ['vi', 'en'] &&
        (!('name' in d) || (d.name is string && d.name.size() <= 80)) &&
        (!('appVersion' in d) || (d.appVersion is string && d.appVersion.size() <= 32)) &&
        (!('osVersion' in d) || (d.osVersion is string && d.osVersion.size() <= 40)) &&
        (!('model' in d) || d.model in ['iPhone', 'iPad', 'Android phone', 'Android tablet']) &&
        (!('lastActiveAt' in d) || d.lastActiveAt == request.time ||
          (resource != null && d.lastActiveAt == resource.data.get('lastActiveAt', null))) &&
        d.updatedAt == request.time;
    }

    // Deletion jobs (13l, 13n): the requester follows "Đang xoá…" until the purge is verified.
    match /deletionJobs/{jobId} {
      allow get: if signedIn() && resource.data.requestedBy == request.auth.uid;
      allow list, write: if false;
    }

    // Exports (R-187): the requester sees their own jobs; files are read through Storage Rules.
    match /dataJobs/{jobId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ---- Premium billing (plan §5.2, §6.1; D-072 #6) ----
    // Purchase intents, store-account bindings and the notification ledger are Functions-only:
    // a client never reads a store reference or writes a binding (the app asks the callables).
    match /purchaseIntents/{intentId} {
      allow read, write: if false;
    }
    match /billingAccounts/{accountId} {
      allow read, write: if false;
    }
    match /billingEvents/{eventId} {
      allow read, write: if false;
    }
    // ---- end Premium billing ----

    // ---- Child Life Assistant (docs/assistant/data.md, P-158, D-075 #2) ----
    // Conversations, tasks, drafts, events and quotes are written by Functions only and read by
    // their owner while still an active member of the scope's baby; the baby's shared thread is
    // read by its Cùng nuôi and Người chăm sóc (below; domain records are shared by role). Executions and the request ledger are never readable. Domain
    // records written for a confirmed draft keep the module's own rules (clients still write
    // `source: 'app'` only).
    function assistantOwner(d) {
      return signedIn() && d.ownerUid == request.auth.uid && activeMember(d.scope.babyId);
    }
    // ---- D-075 #2: the baby's shared thread (Cùng nuôi + Người chăm sóc; relatives never) ----
    // A conversation with `shared: true` and the tasks with `visibility: 'shared'` (with their
    // drafts and events) are readable by every active Cùng nuôi / Người chăm sóc of the scope's
    // baby. Household / spending tasks, photo tasks and relatives' tasks stay private (owner).
    function assistantSharer(babyId) {
      return activeMember(babyId) && role(babyId) in ['coParent', 'caregiver'];
    }
    function assistantConversationReadable(d) {
      return assistantOwner(d) ||
        (signedIn() && d.get('shared', false) == true && assistantSharer(d.scope.babyId));
    }
    function assistantTaskReadable(d) {
      return assistantOwner(d) ||
        (signedIn() && d.get('visibility', 'private') == 'shared' &&
          assistantSharer(d.scope.babyId));
    }
    // ---- end D-075 #2 helpers ----
    match /assistantConversations/{conversationId} {
      allow read: if assistantConversationReadable(resource.data);
      allow write: if false;
      match /messages/{messageId} {
        allow read: if assistantConversationReadable(
          get(/databases/$(database)/documents/assistantConversations/$(conversationId)).data);
        allow write: if false;
      }
      // Lumi L7 (P-168 #1): each author's dialogue state (what Lumi waits for, what was just
      // saved: ids, kinds and times). Server-only: the resolver reads it, no client ever does.
      match /dialogue/{uid} {
        allow read, write: if false;
      }
    }
    match /assistantTasks/{taskId} {
      allow read: if assistantTaskReadable(resource.data);
      allow write: if false;
      match /{sub}/{docId} {
        allow read: if sub in ['drafts', 'events'] && assistantTaskReadable(
          get(/databases/$(database)/documents/assistantTasks/$(taskId)).data);
        allow write: if false;
      }
    }
    match /assistantQuotes/{quoteId} {
      allow read: if assistantOwner(resource.data);
      allow write: if false;
    }
    match /assistantExecutions/{executionId} {
      allow read, write: if false;
    }
    match /assistantRequests/{requestKey} {
      allow read, write: if false;
    }
    // Slice A3 (photos): an attachment's state (uploading / ready / deletion_pending / deleted,
    // whether a copy was kept with the expense) is read by its uploader while still a member of
    // the scope; only Functions write it. The cached reading of a photo task
    // (`assistantTasks/{t}/imageReading`) is never readable (see the task subcollections above).
    match /assistantAttachments/{attachmentId} {
      allow read: if assistantOwner(resource.data);
      allow write: if false;
    }
    // ---- end Child Life Assistant ----

    // Family = ownership + quota container (P-001). Owner only until storage views (S11, P-003).
    match /families/{familyId} {
      allow get: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow list, write: if false;

      // Premium & Cá nhân hoá (plan §6.1, M04): entitlement grants and quota ledgers are written by
      // Functions only and never read by clients; the app asks `getCapabilities`. A client flag
      // such as premium=true grants nothing.
      match /grants/{grantId} {
        allow read, write: if false;
      }
      match /quota/{windowKey} {
        allow read, write: if false;
      }
      match /quotaOps/{opKey} {
        allow read, write: if false;
      }
      // "Tính năng & Premium" hub (D-089): admin overrides per feature, written by staff
      // callables only; the app learns the result from getCapabilities / getFeatureAccess.
      match /featureOverrides/{featureKey} {
        allow read, write: if false;
      }

      // Chi tiêu categories, shared by the family's babies (8m–8o, P-140): read by whoever may
      // see or record spending for one of them; Cùng nuôi add, edit, reorder and hide. Delete
      // moves expenses across babies, so it goes through deleteSpendingCategory (Functions).
      match /spendingCategories/{categoryId} {
        allow read: if spendingReaderOf(familyId);
        allow create: if spendingManagerOf(familyId) && validNewCategory(categoryId);
        allow update: if spendingManagerOf(familyId) && validCategoryUpdate(categoryId);
        allow delete: if false;
      }

      // ---- Chi tiêu currencies (D-075 #4) ----
      // The household's currency (`main`): the add form's default and new budgets' currency.
      // Read like the categories; any Cùng nuôi of one of the family's babies sets it.
      match /spendingSettings/{docId} {
        allow read: if docId == 'main' && spendingReaderOf(familyId);
        allow create, update: if docId == 'main' && spendingManagerOf(familyId) &&
          validSpendingSettings();
        allow delete: if false;
      }
      // ---- end Chi tiêu currencies ----
    }

    // Member-visible profile: nickname, avatar ref, trackers, time zone ("Người thân chỉ thấy
    // tên thân mật", R-009). All writes go through Functions in S2.
    match /babies/{babyId} {
      allow get: if activeMember(babyId);
      allow list, write: if false;

      // DOB and gender: Cùng nuôi, or relatives granted "Thông tin bé" (§5, 121:11672).
      // Caregivers never see the full profile.
      match /restricted/{docId} {
        allow get: if docId == 'profile' && activeMember(babyId) && (
          role(babyId) == 'coParent' ||
          (role(babyId) == 'relative' && get(memberDoc(babyId)).data.get('extraRights', {}).get('viewBabyInfo', false) == true)
        );
        allow list, write: if false;
      }

      // Family list (14a): every active member sees who cares for the baby (view only for
      // caregivers and relatives, §5); one's own membership stays readable after removal (R-025).
      match /members/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || activeMember(babyId));
        allow list: if activeMember(babyId);
        allow write: if false;
      }

      // "Đang chờ nhận lời" (14a): pending invites, Cùng nuôi only. Written by Functions.
      match /pendingInvites/{inviteId} {
        allow read: if activeMember(babyId) && role(babyId) == 'coParent';
        allow write: if false;
      }

      // Care records (S4). Written directly by the app so the Firestore cache is the offline
      // outbox; client ids make retries idempotent. Never hard-deleted by clients: "Xóa" is a
      // soft delete with undo and a 30-day bin purged by a scheduled job.
      match /records/{recordId} {
        allow read: if canReadCare(babyId);
        allow create: if canLog(babyId) && babyOpen(babyId) && validNewRecord(babyId, recordId);
        allow update: if canLog(babyId) && babyOpen(babyId) && canEditRecord(babyId) && validRecordUpdate();
        allow delete: if false;
      }

      // Sổ tiêm chủng (P-133): read like care; Cùng nuôi write any dose, Người chăm sóc record
      // and change what they recorded (as D-022); relatives with daily care only view. Shapes
      // mirror packages/contracts/src/vaccines.ts.
      match /vaccines/{doseKey} {
        allow read: if canReadCare(babyId);
        allow create: if canLog(babyId) && babyOpen(babyId) && validNewVaccineDose(babyId, doseKey);
        allow update: if canLog(babyId) && babyOpen(babyId) && canEditRecord(babyId) &&
          validVaccineDoseUpdate(doseKey);
        allow delete: if canLog(babyId) && canEditRecord(babyId);
      }

      // ---------- Chi tiêu (Figma v1.1 8a–8o, D-055 … D-057, P-140) ----------
      // Cùng nuôi see and change everything. Anyone else only with the 8l rights: "Ghi khoản đã
      // chi" records and sees their own items only; "Xem toàn bộ chi tiêu" reads every item, the
      // budget and the recurring list. Shapes mirror packages/contracts/src/spending.ts.
      match /expenses/{expenseId} {
        allow read: if canViewSpending(babyId) ||
          (canRecordSpending(babyId) && resource.data.createdBy == request.auth.uid);
        allow create: if canRecordSpending(babyId) && babyOpen(babyId) &&
          validNewExpense(babyId, expenseId);
        allow update: if canRecordSpending(babyId) && babyOpen(babyId) &&
          (role(babyId) == 'coParent' || resource.data.createdBy == request.auth.uid) &&
          validExpenseUpdate(babyId);
        allow delete: if false;
      }

      // Nhập chi tiêu (D-060, P-144): the reading, progress and result of an import. Written by
      // Functions only (analyzeSpendingImport, confirmSpendingImport, the import trigger).
      match /spendingImports/{importId} {
        allow read: if spendingParent(babyId);
        allow write: if false;
      }

      // The monthly budget (8h): one document.
      match /spending/{docId} {
        allow read: if docId == 'budget' && canViewSpending(babyId);
        allow create, update: if docId == 'budget' && spendingParent(babyId) && babyOpen(babyId) &&
          validBudget();
        allow delete: if false;
      }

      // Recurring items (8i); occurrences are added by Functions (D-057).
      match /recurringExpenses/{recurringId} {
        allow read: if canViewSpending(babyId);
        allow create: if spendingParent(babyId) && babyOpen(babyId) &&
          validNewRecurring(babyId, recurringId);
        allow update: if spendingParent(babyId) && babyOpen(babyId) && validRecurringUpdate();
        allow delete: if spendingParent(babyId);
      }

      // The book's plan (6in1 / 5in1, reminders, recipients, book photos): Cùng nuôi only.
      match /vaccinePlan/{docId} {
        allow read: if canReadCare(babyId);
        allow write: if docId == 'main' && activeMember(babyId) && role(babyId) == 'coParent' &&
          babyOpen(babyId) && validVaccinePlan(babyId);
      }

      // Vaccination reminder bookkeeping (sent / snoozed): the scheduler Function only.
      match /vaccineReminders/{id} {
        allow read, write: if false;
      }

      // Vitamin A campaign rounds taken (D-083, plan §3, 9g): one document, `vitaminA`. Active
      // members read it; Cùng nuôi mark and unmark rounds (an empty `taken` or a delete clears
      // it). Mirrors `vitaminTakenSchema` (packages/contracts/src/nutrition.ts).
      match /nutrition/{docId} {
        allow get: if docId == 'vitaminA' && activeMember(babyId);
        allow list: if false;
        allow create, update: if docId == 'vitaminA' && isParent(babyId) && babyOpen(babyId) &&
          validVitaminA();
        allow delete: if docId == 'vitaminA' && isParent(babyId) && babyOpen(babyId);
      }

      // Ăn dặm settings (D-085, P-164 #3, 5a): one document, `settings`. Members who read care
      // read it; Cùng nuôi write it ("Bắt đầu theo dõi", "Không gợi ý món này", "Bác sĩ đã cho ăn
      // lại"); never deleted from a client. Mirrors `solidsSettingsSchema`.
      match /solids/{docId} {
        allow get: if docId == 'settings' && canReadCare(babyId);
        allow list: if false;
        allow create, update: if docId == 'settings' && isParent(babyId) && babyOpen(babyId) &&
          validSolidsSettings();
        allow delete: if false;
      }

      // Bữa ăn dặm (D-085, P-164 #4–#6, #13): written by the app like care records (client ids,
      // the Firestore cache as the offline outbox). Never hard-deleted by clients: "Xoá" is a soft
      // delete with undo and the 30-day bin, purged by the bin job with the meal's photo. Cùng nuôi
      // edit any meal, Người chăm sóc only their own (D-022); relatives with "Chăm sóc hằng ngày"
      // only read. The 6-month start is the app's gate (D-085 #4), not checked here. Mirrors
      // `mealSchema`.
      match /meals/{mealId} {
        allow read: if canReadCare(babyId);
        allow create: if canLog(babyId) && babyOpen(babyId) && validNewMeal(babyId, mealId);
        allow update: if canLog(babyId) && babyOpen(babyId) && canEditRecord(babyId) &&
          validMealUpdate(babyId);
        allow delete: if false;
      }

      // Công thức nhà mình (D-086, plan §12 #2): the family's own recipes, written like meals
      // (client ids `fr_…`, soft delete with undo and the 30-day bin, purged with their photo).
      // Cùng nuôi and Người chăm sóc create; the writer or a Cùng nuôi edits and deletes (D-022);
      // relatives with "Chăm sóc hằng ngày" only read. The family's own text is never blocked like
      // editorial copy (the app only nudges). Mirrors `familyRecipeSchema`.
      match /recipes/{recipeId} {
        allow read: if canReadCare(babyId);
        allow create: if canLog(babyId) && babyOpen(babyId) &&
          validNewFamilyRecipe(babyId, recipeId);
        allow update: if canLog(babyId) && babyOpen(babyId) && canEditRecord(babyId) &&
          validFamilyRecipeUpdate(babyId);
        allow delete: if false;
      }

      // "Đã ghi hôm nay" per baby-local date, kept by the onCareRecordWrite trigger.
      match /days/{date} {
        allow read: if canReadCare(babyId);
        allow write: if false;
      }

      // ---------- Nhịp lớn lên (plan §6.1, §7.1, D-072 #2, D-073) ----------
      // Check-ins (C01, C02, NL05b): written by the phone (offline-safe; the id is the
      // idempotency key) by Cùng nuôi and Người chăm sóc, as themselves (M03, M04); edits keep
      // who, which baby and which day and bump `revision`; only the author deletes. Read by
      // `history.read` roles (relatives only with "Chăm sóc hằng ngày"). Mirrors `checkInSchema`.
      match /checkins/{checkInId} {
        allow read: if canReadCare(babyId);
        allow create: if canLog(babyId) && babyOpen(babyId) && validNewCheckIn(babyId, checkInId);
        allow update: if canLog(babyId) && babyOpen(babyId) &&
          resource.data.authorUid == request.auth.uid && validCheckInUpdate();
        allow delete: if canLog(babyId) && resource.data.authorUid == request.auth.uid;
      }

      // Feedback on a suggestion (AC01, AC02): free data, immutable once written; the author may
      // take it back. Mirrors `recFeedbackSchema`.
      match /recFeedback/{feedbackId} {
        allow read: if canReadCare(babyId);
        allow create: if canLog(babyId) && babyOpen(babyId) && validNewFeedback(babyId, feedbackId);
        allow update: if false;
        allow delete: if canLog(babyId) && resource.data.authorUid == request.auth.uid;
      }

      // Suggestions (nextAction / composeHome) and the facts version: Functions only (M04).
      match /recommendations/{recommendationId} {
        allow read: if canReadCare(babyId);
        allow write: if false;
      }
      match /facts/{factId} {
        allow read: if canReadCare(babyId);
        allow write: if false;
      }

      // Hiểu con (D-150, D-151 #6): written by Functions only; parents and caregivers who read
      // care. Relatives do not see insights in V1. A Free household's document holds no figures.
      match /insights/{docId} {
        allow read: if canReadCare(babyId) && !isRelative(babyId);
        allow write: if false;
      }

      // ---------- Premium Slice 3 · AI summaries, NL07b episodes (plan §5.5, §6.1) ----------
      // Stored summaries (SU01): written only by `generateSummary` (M04); read by history.read
      // roles, except the milestone nudge (`moment`), which stays with Cùng nuôi like milestones.
      match /summaries/{summaryId} {
        allow read: if canReadCare(babyId) &&
          (resource.data.kind != 'moment' || isParent(babyId));
        allow write: if false;
      }

      // P-181 "Ai đang trông bé": the whole family who reads care sees who is on duty; written by
      // `setCareDuty` / `markHandover` only.
      match /careDuty/{doc} {
        allow read: if canReadCare(babyId);
        allow write: if false;
      }

      // D-093 "Gửi cho Jun": a sent handover is read by its sender and its recipient only (sent,
      // seen, received); written by `sendHandover` / `markHandover`.
      match /handoverSends/{sendId} {
        allow read: if canReadCare(babyId) &&
          (resource.data.senderUid == request.auth.uid ||
            resource.data.recipientUid == request.auth.uid);
        allow write: if false;
      }

      // Observation episodes (NL07b): confirmed and closed by people (Cùng nuôi, Người chăm
      // sóc, as themselves); the server never closes one. Read by history.read roles. Mirrors
      // `observationEpisodeSchema` + createdAt / updatedAt.
      match /episodes/{episodeId} {
        allow read: if canReadCare(babyId);
        allow create: if canLog(babyId) && babyOpen(babyId) && validNewEpisode(babyId, episodeId);
        allow update: if canLog(babyId) && babyOpen(babyId) && validEpisodeClose();
        allow delete: if false;
      }

      // Running timers (S5, P-011): one slot per type, shared live ("Cả nhà đang thấy"). The
      // first start owns it; a second device's start is refused and it joins the running one.
      match /timers/{type} {
        allow read: if canReadCare(babyId);
        allow create: if canLog(babyId) && babyOpen(babyId) && validNewTimer(babyId, type);
        allow update: if canLog(babyId) && babyOpen(babyId) && validTimerUpdate();
        allow delete: if canLog(babyId);
      }

      // Overlapping sleeps found by the server (27, R-075); resolved through a callable.
      match /conflicts/{conflictId} {
        allow read: if canReadCare(babyId);
        allow write: if false;
      }

      // Memories (S9). Written by Functions only (upload sessions, processing, batch actions).
      // Cùng nuôi see everything, including uploads in progress and "Đã xoá gần đây"; relatives
      // only published Gia đình memories and ready Gia đình items (D-002, P-035, R-119); caregivers
      // never see Kỷ niệm (12a, 10o).
      match /memories/{memoryId} {
        allow read: if isParent(babyId) || (isRelative(babyId) &&
          resource.data.audience == 'family' && resource.data.state == 'published' &&
          resource.data.deleted == false);
        allow write: if false;
      }

      match /media/{mediaId} {
        allow read: if isParent(babyId) || (isRelative(babyId) &&
          resource.data.effectiveAudience == 'family' && resource.data.status == 'ready' &&
          resource.data.deleted == false);
        // The uploader marks a video "waiting for Wi-Fi" on their device, so the batch notice
        // need not wait for it (P-030, Q-019).
        allow update: if isParent(babyId) && resource.data.createdBy == request.auth.uid &&
          resource.data.status == 'uploading' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clientState']) &&
          request.resource.data.clientState in [null, 'waitingWifi'];
        allow create, delete: if false;
      }

      // The uploader's own batches ("Đã báo cho Bà nội, Ông ngoại", R-115).
      match /uploadBatches/{batchId} {
        allow read: if isParent(babyId) && resource.data.createdBy == request.auth.uid;
        allow write: if false;
      }

      // Video kỷ niệm render jobs (D-068; MM08, MM14, MM15 drafts): the Cùng nuôi who asked follows
      // them; Functions and the renderer write them.
      match /keepsakeJobs/{jobId} {
        allow read: if isParent(babyId) && resource.data.uid == request.auth.uid;
        allow write: if false;
      }

      match /printDrafts/{uid} {
        allow read: if isParent(babyId) && request.auth.uid == uid;
        allow write: if false;
      }
      match /printOrders/{orderId} {
        allow read: if isParent(babyId) && resource.data.uid == request.auth.uid;
        allow write: if false;
      }
      // PR-1 (D-127 Q8): the print file job the Cùng nuôi who asked follows; Functions write it.
      match /printExportJobs/{jobId} {
        allow read: if isParent(babyId) && resource.data.uid == request.auth.uid;
        allow write: if false;
      }

      // The baby's milestones: "Mốc nhà mình đã tạo" (10h3, 10h4, R-105), MS01 "Lưu vào Mốc" and
      // Mốc phát triển records (3a–3g, D-076 #6; packages/contracts/src/milestones.ts). One
      // collection: custom `ms_<hex>` and reference `p_<referenceId>`. Written by a Cùng nuôi only
      // (`moments.create`); caregivers and relatives never read them (a relative sees a milestone
      // only through a Kỷ niệm memory and its audience). The legacy Kỷ niệm shape is still accepted.
      match /milestones/{milestoneId} {
        allow read: if isParent(babyId);
        allow create: if isParent(babyId) && babyOpen(babyId) &&
          (validNewMilestone(babyId, milestoneId) || validNewBabyMilestone(babyId, milestoneId));
        allow update: if isParent(babyId) && babyOpen(babyId) && validMilestoneUpdate(babyId);
        allow delete: if isParent(babyId) && babyOpen(babyId);
      }

      // Family notices (R-120), delivered by Functions.
      match /notifications/{notificationId} {
        allow read, write: if false;
      }

      // Albums (S10, 10d–10e10): written by Functions (membership and effective audience,
      // D-002, P-035). Relatives see shared albums only (11e); caregivers never (12a).
      match /albums/{albumId} {
        allow read: if isParent(babyId) ||
          (isRelative(babyId) && resource.data.audience == 'family');
        allow write: if false;

        match /items/{mediaId} {
          allow read: if isParent(babyId) || (isRelative(babyId) &&
            get(/databases/$(database)/documents/babies/$(babyId)/albums/$(albumId)).data.audience == 'family');
          allow write: if false;
        }
      }

      // "Yêu thích" (R-107): private to each person, only on what they can see.
      match /favorites/{favoriteId} {
        allow read: if seesMemories(babyId) && resource.data.uid == request.auth.uid;
        allow create: if seesMemories(babyId) && babyOpen(babyId) && validFavorite(babyId, favoriteId);
        allow delete: if seesMemories(babyId) && resource.data.uid == request.auth.uid;
        allow update: if false;
      }

      // "Thương" (11c, 11f, 11g): counts for everyone (on the target), names for parents only.
      match /reactions/{reactionId} {
        allow read: if isParent(babyId) ||
          (isRelative(babyId) && resource.data.uid == request.auth.uid);
        allow create: if seesMemories(babyId) && babyOpen(babyId) && validLove(babyId, reactionId);
        allow delete: if seesMemories(babyId) && resource.data.uid == request.auth.uid;
        allow update: if false;
      }

      // "Nhắn ba mẹ" / "Nhắn Mẹ" (D-034): one-way to the parents; the sender reads their own.
      match /messages/{messageId} {
        allow read: if isParent(babyId) ||
          (activeMember(babyId) && resource.data.from == request.auth.uid);
        allow create: if activeMember(babyId) && babyOpen(babyId) && validMessage(babyId, messageId);
        // Parents mark a message read for themselves only.
        allow update: if isParent(babyId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']) &&
          request.resource.data.readBy.diff(resource.data.readBy).affectedKeys()
            .hasOnly([request.auth.uid]) &&
          request.resource.data.readBy[request.auth.uid] == true;
        allow delete: if false;
      }

      // Stories (S12, 14a–14g, 11i). Parents write drafts themselves (one document per story);
      // saving, re-saving and deleting a saved story go through Functions (audience, D-002 photo
      // sharing, one notice — P-091). Relatives read saved Gia đình stories; caregivers never.
      match /stories/{storyId} {
        allow read: if (isParent(babyId) && (resource.data.status == 'saved' ||
            resource.data.createdBy in [request.auth.uid, 'ai'])) ||
          (isRelative(babyId) && resource.data.status == 'saved' &&
            resource.data.audience == 'family');
        allow create: if isParent(babyId) && babyOpen(babyId) && validNewStory(babyId, storyId);
        allow update: if isParent(babyId) && babyOpen(babyId) && validStoryEdit();
        allow delete: if isParent(babyId) && resource.data.status == 'draft' &&
          resource.data.createdBy in [request.auth.uid, 'ai'];
      }

      // Reminders (S7, 8a–8e, 12f). Cùng nuôi create, edit and delete (D-030, D-031); caregivers
      // view and mark done; relatives never see them (D-018). Notifications are local to the
      // device in notifyDevice (R-091); any viewer may move it to their own device (D-029).
      // D-075 #5: all day (`allDay`, `dueDate`) and an assignee, set by Cùng nuôi.
      match /reminders/{reminderId} {
        allow read: if canSeeReminders(babyId);
        allow create: if canSeeReminders(babyId) && role(babyId) == 'coParent' && babyOpen(babyId) &&
          validNewReminder(babyId, reminderId);
        allow update: if canSeeReminders(babyId) && babyOpen(babyId) && validReminderUpdate(babyId);
        allow delete: if canSeeReminders(babyId) && role(babyId) == 'coParent';
      }

      // Rule reminders (v1.0 1a–1h, D-051): read like reminders; written only by the
      // Functions (saveRuleReminder, setRuleReminderEnabled, deleteRuleReminder,
      // answerRuleReminder) and the scheduler, which keep the schedule and recipients valid.
      match /reminderRules/{ruleId} {
        allow read: if canSeeReminders(babyId);
        allow write: if false;
        match /occurrences/{occurrenceId} {
          allow read: if canSeeReminders(babyId);
          allow write: if false;
        }
      }

      // Cùng Chăm Con (D-135): the day's shared plan, its everyday tasks and its history. Read
      // by whoever reads care; written only by the plan Functions (startCarePlanDay, …).
      match /carePlanDays/{date} {
        allow read: if canReadCare(babyId);
        allow write: if false;
        match /items/{itemId} {
          allow read: if canReadCare(babyId);
          allow write: if false;
        }
      }
      match /carePlanTemplate/{templateId} {
        allow read: if canReadCare(babyId);
        allow write: if false;
      }
      match /carePlanHistory/{entryId} {
        allow read: if canReadCare(babyId);
        allow write: if false;
      }
      // D-136: "Tự tạo lịch mỗi sáng" and the method last used; written by the plan Functions.
      match /carePlanSettings/{docId} {
        allow read: if canReadCare(babyId);
        allow write: if false;
      }
    }

    // ---------- Care (S4) ----------

    // Cùng nuôi and Người chăm sóc see care; relatives only with "Chăm sóc hằng ngày" (D-018).
    function canReadCare(babyId) {
      return activeMember(babyId) && (
        role(babyId) in ['coParent', 'caregiver'] ||
        get(memberDoc(babyId)).data.get('extraRights', {}).get('viewDailyCare', false) == true
      );
    }

    // ---------- Nhịp lớn lên shapes (packages/contracts/src/rhythm.ts, personalization.ts) ----------

    function isoDate(v) {
      return v is string && v.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    function checkInFields() {
      return ['id', 'babyId', 'date', 'authorUid', 'observation', 'when', 'since', 'tried',
        'healthSigns', 'note', 'revision', 'createdAt', 'updatedAt'];
    }

    function validCheckInBody(d) {
      return d.keys().hasOnly(checkInFields()) && d.keys().hasAll(checkInFields()) &&
        isoDate(d.date) &&
        d.observation in ['sleep', 'feeding', 'soothing', 'new_skill', 'usual', 'health'] &&
        d.when in [null, 'night', 'day', 'both'] &&
        d.since in [null, 'today', 'days_2_3', 'longer'] &&
        d.tried is list && d.tried.size() <= 6 &&
        d.tried.hasOnly(['rocking', 'white_noise', 'feeding', 'skin_to_skin', 'swaddle', 'none']) &&
        d.healthSigns is list && d.healthSigns.size() <= 8 &&
        d.healthSigns.hasOnly(['fever_young', 'breathing', 'lethargic', 'poor_feeding',
          'inconsolable', 'lost_skill', 'dehydration', 'seizure']) &&
        (d.note == null || (d.note is string && d.note.size() <= 500)) &&
        d.revision is int && d.updatedAt == request.time;
    }

    function validNewCheckIn(babyId, checkInId) {
      let d = request.resource.data;
      return checkInId.matches('^ci_[a-f0-9]{32}$') && d.id == checkInId && d.babyId == babyId &&
        d.authorUid == request.auth.uid && d.revision == 1 && d.createdAt == request.time &&
        validCheckInBody(d);
    }

    // The same check-in, edited: who, which baby, which day and when it was made never change.
    function validCheckInUpdate() {
      let d = request.resource.data;
      let o = resource.data;
      return d.id == o.id && d.babyId == o.babyId && d.authorUid == o.authorUid &&
        d.date == o.date && d.createdAt == o.createdAt && d.revision == o.revision + 1 &&
        validCheckInBody(d);
    }

    function validNewFeedback(babyId, feedbackId) {
      let d = request.resource.data;
      let fields = ['id', 'babyId', 'authorUid', 'contentId', 'contentVersion', 'kind', 'date',
        'note', 'createdAt'];
      return feedbackId.matches('^fb_[a-f0-9]{32}$') &&
        d.keys().hasOnly(fields) && d.keys().hasAll(fields) &&
        d.id == feedbackId && d.babyId == babyId && d.authorUid == request.auth.uid &&
        d.contentId is string && d.contentId.size() >= 1 && d.contentId.size() <= 60 &&
        d.contentVersion is int && d.contentVersion >= 1 &&
        d.kind in ['started', 'helpful', 'unsure', 'not_suitable', 'not_today'] &&
        isoDate(d.date) &&
        (d.note == null || (d.note is string && d.note.size() <= 300)) &&
        d.createdAt == request.time;
    }

    // NL07b: a new episode is open, confirmed by the caller, over this baby's check-ins.
    function validNewEpisode(babyId, episodeId) {
      let d = request.resource.data;
      let fields = ['id', 'babyId', 'startDate', 'endDate', 'confirmedBy', 'checkInIds', 'status',
        'closedBy', 'createdAt', 'updatedAt'];
      return episodeId.matches('^ep_[a-f0-9]{32}$') &&
        d.keys().hasOnly(fields) && d.keys().hasAll(fields) &&
        d.id == episodeId && d.babyId == babyId && d.confirmedBy == request.auth.uid &&
        isoDate(d.startDate) && d.endDate == null && d.status == 'open' && d.closedBy == null &&
        d.checkInIds is list && d.checkInIds.size() >= 1 && d.checkInIds.size() <= 30 &&
        d.createdAt == request.time && d.updatedAt == request.time;
    }

    // Closing, once, by the caller: only status, end date, who closed it and updatedAt change.
    function validEpisodeClose() {
      let d = request.resource.data;
      return resource.data.status == 'open' &&
        d.diff(resource.data).affectedKeys().hasOnly(['status', 'endDate', 'closedBy', 'updatedAt']) &&
        d.status == 'closed' && d.closedBy == request.auth.uid &&
        isoDate(d.endDate) && d.endDate >= resource.data.startDate &&
        d.updatedAt == request.time;
    }

    // Relatives never log (12a, 7b: no "+").
    function canLog(babyId) {
      return activeMember(babyId) && role(babyId) in ['coParent', 'caregiver'] &&
        !writeSuspended(babyId);
    }

    // Q-012 → D-022: any Cùng nuôi edits or deletes any record; a caregiver only their own
    // ("Bản ghi của ba mẹ: chỉ xem", 12a).
    function canEditRecord(babyId) {
      return role(babyId) == 'coParent' || resource.data.createdBy == request.auth.uid;
    }

    function notFuture(ts) {
      return ts is timestamp && ts <= request.time + duration.value(5, 'm');
    }

    function intIn(v, lo, hi) {
      return v is int && v >= lo && v <= hi;
    }

    function numIn(v, lo, hi) {
      return (v is int || v is float) && v >= lo && v <= hi;
    }

    function optionalDuration(x) {
      return x.durationMin == null || intIn(x.durationMin, 1, 240);
    }

    // Shapes and ranges mirror packages/contracts/src/care.ts.
    function validCareData(type, x) {
      return (type == 'bottle' && x.keys().hasOnly(['amountMl', 'milk']) &&
          x.keys().hasAll(['amountMl', 'milk']) &&
          (x.amountMl == null || intIn(x.amountMl, 1, 500)) &&
          x.milk in ['breastMilk', 'formula']) ||
        (type == 'breast' &&
          x.keys().hasOnly(['side', 'durationMin', 'leftMin', 'rightMin', 'endSide']) &&
          x.keys().hasAll(['side', 'durationMin']) &&
          x.side in ['left', 'right', 'both'] && optionalDuration(x) &&
          (x.get('leftMin', null) == null || intIn(x.leftMin, 0, 240)) &&
          (x.get('rightMin', null) == null || intIn(x.rightMin, 0, 240)) &&
          x.get('endSide', null) in [null, 'left', 'right']) ||
        (type == 'sleep' && x.keys().size() == 0) ||
        (type == 'pump' && x.keys().hasOnly(['side', 'amountMl', 'durationMin']) &&
          x.keys().hasAll(['side', 'amountMl', 'durationMin']) &&
          x.side in ['left', 'right', 'both'] && intIn(x.amountMl, 1, 1000) &&
          optionalDuration(x)) ||
        (type == 'diaper' && x.keys().hasOnly(['kind']) &&
          x.kind in ['wet', 'dirty', 'both']) ||
        // Head circumference (owner 2026-10-16): optional key, absent on older records and apps.
        (type == 'growth' &&
          x.keys().hasOnly(['weightKg', 'lengthCm', 'measuredOn', 'headCm']) &&
          x.keys().hasAll(['weightKg', 'lengthCm', 'measuredOn']) &&
          numIn(x.weightKg, 0.3, 40) &&
          (x.lengthCm == null || numIn(x.lengthCm, 20, 150)) &&
          (x.get('headCm', null) == null || numIn(x.headCm, 20, 60)) &&
          x.measuredOn is string && x.measuredOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    // When it happened: no future times (G-021, 5 min of clock skew); spans end after they start.
    function validCareBody(d) {
      return d.type in ['bottle', 'breast', 'pump', 'sleep', 'diaper', 'growth'] &&
        notFuture(d.occurredAt) &&
        (d.endedAt == null || (notFuture(d.endedAt) && d.endedAt >= d.occurredAt)) &&
        // A sleep always has an end (a running one is a timer) and lasts at most 24 h.
        (d.type != 'sleep' || (d.endedAt != null &&
          d.endedAt <= d.occurredAt + duration.value(24, 'h'))) &&
        d.data is map && validCareData(d.type, d.data);
    }

    function validNewRecord(babyId, recordId) {
      let d = request.resource.data;
      let me = get(memberDoc(babyId)).data;
      return d.keys().hasOnly(['id', 'babyId', 'type', 'occurredAt', 'endedAt', 'data',
          'createdBy', 'author', 'createdAt', 'clientCreatedAt', 'updatedAt', 'updatedBy',
          'deleted', 'deletedAt', 'deletedBy', 'source']) &&
        d.keys().hasAll(['id', 'babyId', 'type', 'occurredAt', 'endedAt', 'data', 'createdBy',
          'author', 'createdAt', 'clientCreatedAt', 'updatedAt', 'updatedBy', 'deleted',
          'deletedAt', 'deletedBy', 'source']) &&
        recordId.matches('^r_[a-f0-9]{32}$') && d.id == recordId && d.babyId == babyId &&
        d.createdBy == request.auth.uid && d.updatedBy == request.auth.uid &&
        d.createdAt == request.time && d.updatedAt == request.time &&
        d.clientCreatedAt is timestamp &&
        d.deleted == false && d.deletedAt == null && d.deletedBy == null &&
        d.source == 'app' &&
        // "Mẹ ghi" / "Cô Lan ghi" (D-024) must be the writer's own membership.
        d.author is map && d.author.keys().hasOnly(['name', 'relation', 'relationCustom']) &&
        d.author.name == me.displayName && d.author.relation == me.relation &&
        d.author.relationCustom == me.get('relationCustom', null) &&
        validCareBody(d);
    }

    // ---------- Timers (S5) ----------

    function validSide(s) {
      return s is map && s.keys().hasOnly(['accumulatedMs', 'runningSince']) &&
        s.keys().hasAll(['accumulatedMs', 'runningSince']) &&
        s.accumulatedMs is int && s.accumulatedMs >= 0 &&
        (s.runningSince == null || notFuture(s.runningSince));
    }

    function validTimerBody(d) {
      return notFuture(d.startedAt) &&
        d.paused is bool && d.pausedSides is list && d.pausedSides.size() <= 2 &&
        ((d.type == 'sleep' && d.sides == null) ||
          (d.type in ['breast', 'pump'] && d.sides is map &&
            d.sides.keys().hasOnly(['left', 'right']) &&
            d.sides.keys().hasAll(['left', 'right']) &&
            validSide(d.sides.left) && validSide(d.sides.right)));
    }

    function validNewTimer(babyId, type) {
      let d = request.resource.data;
      let me = get(memberDoc(babyId)).data;
      return type in ['sleep', 'breast', 'pump'] && d.type == type && d.babyId == babyId &&
        d.keys().hasOnly(['type', 'babyId', 'sessionId', 'startedAt', 'startedBy', 'author',
          'sides', 'paused', 'pausedSides', 'updatedAt', 'updatedBy']) &&
        d.keys().hasAll(['type', 'babyId', 'sessionId', 'startedAt', 'startedBy', 'author',
          'sides', 'paused', 'pausedSides', 'updatedAt', 'updatedBy']) &&
        d.sessionId is string && d.sessionId.matches('^[a-f0-9]{32}$') &&
        d.startedBy == request.auth.uid && d.updatedBy == request.auth.uid &&
        d.updatedAt == request.time &&
        d.author is map && d.author.keys().hasOnly(['name', 'relation', 'relationCustom']) &&
        d.author.name == me.displayName && d.author.relation == me.relation &&
        d.author.relationCustom == me.get('relationCustom', null) &&
        validTimerBody(d);
    }

    // Pause, switch side, edit start: the session itself never changes hands.
    function validTimerUpdate() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys()
          .hasOnly(['startedAt', 'sides', 'paused', 'pausedSides', 'updatedAt', 'updatedBy']) &&
        d.updatedBy == request.auth.uid && d.updatedAt == request.time &&
        validTimerBody(d);
    }

    function validRecordUpdate() {
      let d = request.resource.data;
      let o = resource.data;
      let changed = d.diff(o).affectedKeys();
      let deleteKeys = ['deleted', 'deletedAt', 'deletedBy', 'updatedAt', 'updatedBy'];
      return d.updatedBy == request.auth.uid && d.updatedAt == request.time && (
        // "Sửa": time and details only.
        (o.deleted == false && d.deleted == false &&
          changed.hasOnly(['occurredAt', 'endedAt', 'data', 'updatedAt', 'updatedBy']) &&
          validCareBody(d)) ||
        // "Xóa bản ghi" → soft delete.
        (o.deleted == false && d.deleted == true && changed.hasOnly(deleteKeys) &&
          d.deletedAt == request.time && d.deletedBy == request.auth.uid) ||
        // "Hoàn tác" (5 s) or restore from "Đã xoá gần đây".
        (o.deleted == true && d.deleted == false && changed.hasOnly(deleteKeys) &&
          d.deletedAt == null && d.deletedBy == null)
      );
    }

    // ---------- Memories (S9) ----------

    function isParent(babyId) {
      return activeMember(babyId) && role(babyId) == 'coParent';
    }

    function isRelative(babyId) {
      return activeMember(babyId) && role(babyId) == 'relative';
    }

    function validNewMilestone(babyId, milestoneId) {
      let d = request.resource.data;
      let me = get(memberDoc(babyId)).data;
      return milestoneId.matches('^ms_[a-f0-9]{32}$') &&
        d.keys().hasOnly(['id', 'babyId', 'name', 'date', 'createdBy', 'author', 'createdAt']) &&
        d.keys().hasAll(['id', 'babyId', 'name', 'date', 'createdBy', 'author', 'createdAt']) &&
        d.id == milestoneId && d.babyId == babyId && d.createdBy == request.auth.uid &&
        d.createdAt == request.time && ownAuthor(d.author, me) &&
        d.name is string && d.name.trim().size() >= 1 && d.name.size() <= 60 &&
        d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // ---------- Mốc phát triển records (D-076 #6) ----------

    function milestoneRecordKeys() {
      return ['id', 'babyId', 'kind', 'referenceId', 'name', 'status', 'date', 'note', 'memoryIds',
        'source', 'createdBy', 'author', 'createdAt', 'updatedBy', 'updatedAt'];
    }

    // What every stored record holds (contracts `babyMilestoneSchema`): observed ones are dated,
    // only reference ones are followed, a note of ≤ 500 characters, ≤ 20 memory ids.
    function validMilestoneBody(d) {
      return d.keys().hasOnly(milestoneRecordKeys()) && d.keys().hasAll(milestoneRecordKeys()) &&
        d.name is string && d.name.trim().size() >= 1 && d.name.size() <= 60 &&
        d.status in ['observed', 'following'] &&
        ((d.status == 'observed' && d.date is string &&
            d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')) ||
          (d.status == 'following' && d.date == null && d.kind == 'reference')) &&
        (d.note == null || (d.note is string && d.note.trim().size() >= 1 && d.note.size() <= 500)) &&
        d.memoryIds is list && d.memoryIds.size() <= 20 &&
        d.source in ['memories', 'milestones', 'rhythm', 'keepsakes'] &&
        d.updatedBy == request.auth.uid && d.updatedAt == request.time;
    }

    function validNewBabyMilestone(babyId, milestoneId) {
      let d = request.resource.data;
      let me = get(memberDoc(babyId)).data;
      return validMilestoneBody(d) &&
        d.id == milestoneId && d.babyId == babyId && d.createdBy == request.auth.uid &&
        d.createdAt == request.time && ownAuthor(d.author, me) &&
        ((d.kind == 'custom' && d.referenceId == null && milestoneId.matches('^ms_[a-f0-9]{32}$')) ||
          (d.kind == 'reference' && d.referenceId is string &&
            d.referenceId.matches('^[a-z][a-z0-9_]{1,39}$') && milestoneId == 'p_' + d.referenceId));
    }

    // Edits (date, note, status, memory links, the denormalised name). Who and when it was first
    // recorded never change; a legacy Kỷ niệm milestone gains the new fields as a custom one.
    function validMilestoneUpdate(babyId) {
      let d = request.resource.data;
      let o = resource.data;
      return validMilestoneBody(d) &&
        d.diff(o).affectedKeys().hasOnly(['name', 'status', 'date', 'note', 'memoryIds', 'updatedBy',
          'updatedAt', 'kind', 'referenceId', 'source']) &&
        d.kind == o.get('kind', 'custom') && d.referenceId == o.get('referenceId', null) &&
        d.source == o.get('source', 'memories');
    }

    // ---------- Albums, favourites, loves, messages (S10) ----------

    function seesMemories(babyId) {
      return isParent(babyId) || isRelative(babyId);
    }

    function babyDoc(babyId, collection, id) {
      return get(/databases/$(database)/documents/babies/$(babyId)/$(collection)/$(id)).data;
    }

    // What a relative may act on: published, shared, not deleted (R-119).
    function targetShared(babyId, target, targetId) {
      return (target == 'media' && babyDoc(babyId, 'media', targetId).effectiveAudience == 'family' &&
          babyDoc(babyId, 'media', targetId).status == 'ready' &&
          babyDoc(babyId, 'media', targetId).deleted == false) ||
        (target == 'memory' && babyDoc(babyId, 'memories', targetId).audience == 'family' &&
          babyDoc(babyId, 'memories', targetId).state == 'published' &&
          babyDoc(babyId, 'memories', targetId).deleted == false) ||
        (target == 'album' && babyDoc(babyId, 'albums', targetId).audience == 'family') ||
        (target == 'story' && babyDoc(babyId, 'stories', targetId).audience == 'family' &&
          babyDoc(babyId, 'stories', targetId).status == 'saved');
    }

    function validStoryContent(d) {
      return d.title is string && d.title.size() <= 120 &&
        (d.coverMediaId == null || d.coverMediaId is string) &&
        d.blocks is list && d.blocks.size() <= 40 &&
        d.kind in ['story', 'letter'] &&
        d.audience in ['parents', 'family'];
    }

    function validNewStory(babyId, storyId) {
      let d = request.resource.data;
      return storyId.matches('^sto_[a-f0-9]{32}$') && d.id == storyId && d.babyId == babyId &&
        d.keys().hasOnly(['id', 'babyId', 'kind', 'origin', 'suggestion', 'status', 'title',
          'coverMediaId', 'blocks', 'audience', 'createdBy', 'author', 'loveCount', 'createdAt',
          'updatedAt', 'updatedBy']) &&
        d.origin == 'manual' && d.suggestion == false && d.status == 'draft' &&
        d.createdBy == request.auth.uid && d.updatedBy == request.auth.uid &&
        d.loveCount == 0 && d.author is map &&
        d.createdAt == request.time && d.updatedAt == request.time &&
        validStoryContent(d);
    }

    // Content edits only; a suggestion becomes the editor's draft ("Lưu nháp"). Status, audience
    // of a saved story and the shared photo list stay with Functions.
    function validStoryEdit() {
      let d = request.resource.data;
      let o = resource.data;
      let changed = d.diff(o).affectedKeys();
      return changed.hasOnly(['title', 'coverMediaId', 'blocks', 'kind', 'audience', 'suggestion',
          'createdBy', 'author', 'updatedAt', 'updatedBy']) &&
        d.updatedAt == request.time && d.updatedBy == request.auth.uid &&
        (o.createdBy == request.auth.uid || o.status == 'saved' ||
          (o.createdBy == 'ai' && d.createdBy == request.auth.uid)) &&
        (!changed.hasAny(['createdBy']) || (o.createdBy == 'ai' && d.createdBy == request.auth.uid)) &&
        (!changed.hasAny(['audience']) || o.status == 'draft') &&
        (!changed.hasAny(['suggestion']) || d.suggestion == false) &&
        validStoryContent(d);
    }

    function validFavorite(babyId, favoriteId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'mediaId', 'createdAt']) &&
        d.keys().hasAll(['uid', 'mediaId', 'createdAt']) &&
        d.uid == request.auth.uid && d.createdAt == request.time &&
        d.mediaId is string && favoriteId == request.auth.uid + '__' + d.mediaId &&
        (isParent(babyId) || targetShared(babyId, 'media', d.mediaId));
    }

    function validLove(babyId, reactionId) {
      let d = request.resource.data;
      let me = get(memberDoc(babyId)).data;
      return d.keys().hasOnly(['uid', 'target', 'targetId', 'author', 'createdAt']) &&
        d.keys().hasAll(['uid', 'target', 'targetId', 'author', 'createdAt']) &&
        d.uid == request.auth.uid && d.createdAt == request.time &&
        d.target in ['media', 'memory', 'album', 'story'] && d.targetId is string &&
        reactionId == d.target + '__' + d.targetId + '__' + request.auth.uid &&
        ownAuthor(d.author, me) &&
        (isParent(babyId) || targetShared(babyId, d.target, d.targetId));
    }

    // Relatives write about what they can see; caregivers "Nhắn Mẹ" from a parent's record.
    function validMessage(babyId, messageId) {
      let d = request.resource.data;
      let me = get(memberDoc(babyId)).data;
      return messageId.matches('^msg_[a-f0-9]{32}$') &&
        d.keys().hasOnly(['id', 'babyId', 'from', 'author', 'context', 'text', 'createdAt', 'readBy']) &&
        d.keys().hasAll(['id', 'babyId', 'from', 'author', 'context', 'text', 'createdAt', 'readBy']) &&
        d.id == messageId && d.babyId == babyId && d.from == request.auth.uid &&
        d.createdAt == request.time && d.readBy == {} && ownAuthor(d.author, me) &&
        d.text is string && d.text.trim().size() >= 1 && d.text.size() <= 1000 &&
        d.context is map && d.context.keys().hasOnly(['kind', 'id']) && d.context.id is string &&
        ((me.role == 'relative' && d.context.kind in ['media', 'memory', 'album', 'story'] &&
            targetShared(babyId, d.context.kind, d.context.id)) ||
          (me.role == 'caregiver' && d.context.kind == 'record'));
    }

    // ---------- Reminders (S7) ----------

    function canSeeReminders(babyId) {
      return activeMember(babyId) && role(babyId) in ['coParent', 'caregiver'];
    }

    // ---------- Sổ tiêm chủng (P-133) ----------

    function optText(v, max) {
      return v == null || (v is string && v.size() <= max);
    }

    function optDate(v) {
      return v == null || (v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function validVaccineFields(d, doseKey) {
      return doseKey.matches('^[a-z0-9]{2,12}_[1-9]$') &&
        d.vaccineId is string && d.dose is int && d.dose >= 1 && d.dose <= 9 &&
        doseKey == d.vaccineId + '_' + string(d.dose) &&
        d.status in ['given', 'declined', 'planned'] &&
        optDate(d.givenOn) && optDate(d.plannedOn) &&
        (d.givenTime == null || (d.givenTime is string && d.givenTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))) &&
        (d.place == null || d.place in ['hospital', 'service', 'station']) &&
        optText(d.facility, 80) && optText(d.reaction, 300) && optText(d.declineReason, 200) &&
        (d.photoPath == null || (d.photoPath is string &&
          d.photoPath.matches('^babies/' + d.babyId + '/vaccines/[A-Za-z0-9_-]{8,64}[.]jpg$'))) &&
        // A given dose has no reason, a declined one no date, a rescheduled one its new date.
        (d.status != 'given' || d.declineReason == null) &&
        (d.status != 'declined' || d.givenOn == null) &&
        (d.status != 'planned' || (d.plannedOn != null && d.givenOn == null)) &&
        d.updatedBy == request.auth.uid && d.updatedAt == request.time;
    }

    function validNewVaccineDose(babyId, doseKey) {
      let d = request.resource.data;
      let me = get(memberDoc(babyId)).data;
      return d.keys().hasOnly(['babyId', 'vaccineId', 'dose', 'status', 'givenOn', 'givenTime',
          'place', 'facility', 'reaction', 'declineReason', 'plannedOn', 'photoPath', 'createdBy',
          'author', 'createdAt', 'updatedAt', 'updatedBy']) &&
        d.keys().hasAll(['babyId', 'vaccineId', 'dose', 'status', 'givenOn', 'givenTime',
          'place', 'facility', 'reaction', 'declineReason', 'plannedOn', 'photoPath', 'createdBy',
          'author', 'createdAt', 'updatedAt', 'updatedBy']) &&
        d.babyId == babyId && d.createdBy == request.auth.uid && d.createdAt == request.time &&
        ownAuthor(d.author, me) && validVaccineFields(d, doseKey);
    }

    function validVaccineDoseUpdate(doseKey) {
      let d = request.resource.data;
      let o = resource.data;
      return d.diff(o).affectedKeys().hasOnly(['status', 'givenOn', 'givenTime', 'place',
          'facility', 'reaction', 'declineReason', 'plannedOn', 'photoPath', 'updatedAt',
          'updatedBy']) &&
        validVaccineFields(d, doseKey);
    }

    // `taken`: { "YYYY-MM": "YYYY-MM-DD" }, a round per month key. Rules cannot loop, so the
    // entries are checked one by one up to 16 (Việt Nam runs 2 rounds a year over 6–36 months).
    function vitaminEntry(t, ks, i) {
      return ks.size() <= i ||
        (ks[i].matches('^[0-9]{4}-(0[1-9]|1[0-2])$') && isoDate(t[ks[i]]));
    }

    function vitaminTaken(t, ks) {
      return ks.size() <= 16 &&
        vitaminEntry(t, ks, 0) && vitaminEntry(t, ks, 1) && vitaminEntry(t, ks, 2) &&
        vitaminEntry(t, ks, 3) && vitaminEntry(t, ks, 4) && vitaminEntry(t, ks, 5) &&
        vitaminEntry(t, ks, 6) && vitaminEntry(t, ks, 7) && vitaminEntry(t, ks, 8) &&
        vitaminEntry(t, ks, 9) && vitaminEntry(t, ks, 10) && vitaminEntry(t, ks, 11) &&
        vitaminEntry(t, ks, 12) && vitaminEntry(t, ks, 13) && vitaminEntry(t, ks, 14) &&
        vitaminEntry(t, ks, 15);
    }

    function validVitaminA() {
      let d = request.resource.data;
      return d.keys().hasOnly(['taken', 'updatedAt', 'updatedBy']) &&
        d.keys().hasAll(['taken', 'updatedAt', 'updatedBy']) &&
        d.taken is map && vitaminTaken(d.taken, d.taken.keys()) &&
        d.updatedBy == request.auth.uid && d.updatedAt == request.time;
    }

    function validVaccinePlan(babyId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['dtp', 'setupDone', 'scheduleFrom', 'remind', 'recipients',
          'bookPhotos', 'updatedAt', 'updatedBy']) &&
        d.keys().hasAll(['dtp', 'setupDone', 'scheduleFrom', 'remind', 'recipients',
          'bookPhotos', 'updatedAt', 'updatedBy']) &&
        optDate(d.scheduleFrom) &&
        (d.dtp == null || d.dtp in ['6in1', '5in1']) && d.setupDone is bool && d.remind is bool &&
        d.recipients is list && d.recipients.size() <= 20 &&
        d.bookPhotos is list && d.bookPhotos.size() <= 10 &&
        d.updatedBy == request.auth.uid && d.updatedAt == request.time;
    }

    // ---------- Ăn dặm (D-085; packages/contracts/src/solids.ts, `solidsLimits`) ----------

    function validSolidsSettings() {
      let d = request.resource.data;
      let fields = ['enabled', 'startedOn', 'showOnToday', 'method', 'hidden', 'cleared',
        'updatedAt', 'updatedBy'];
      return d.keys().hasOnly(fields) && d.keys().hasAll(fields) &&
        d.enabled is bool && (d.startedOn == null || isoDate(d.startedOn)) &&
        d.showOnToday is bool && d.method in ['spoon', 'blw', 'mixed'] &&
        d.hidden is list && d.hidden.size() <= 50 &&
        d.cleared is list && d.cleared.size() <= 50 &&
        d.updatedBy == request.auth.uid && d.updatedAt == request.time;
    }

    function mealFields() {
      return ['id', 'babyId', 'occurredAt', 'slot', 'dish', 'foodIds', 'freeFoods', 'amount',
        'reaction', 'symptoms', 'note', 'recipeId', 'photoPath', 'createdBy', 'author',
        'createdAt', 'clientCreatedAt', 'updatedAt', 'updatedBy', 'deleted', 'deletedAt',
        'deletedBy'];
    }

    // Rules cannot loop: the catalogue ids (≤ 12) and free names (≤ 3) are checked one by one.
    function mealFoodAt(l, i) {
      return l.size() <= i || (l[i] is string && l[i].matches('^fd_[a-z0-9_]{2,40}$'));
    }

    function mealFoodIds(l) {
      return l is list && l.size() <= 12 &&
        mealFoodAt(l, 0) && mealFoodAt(l, 1) && mealFoodAt(l, 2) && mealFoodAt(l, 3) &&
        mealFoodAt(l, 4) && mealFoodAt(l, 5) && mealFoodAt(l, 6) && mealFoodAt(l, 7) &&
        mealFoodAt(l, 8) && mealFoodAt(l, 9) && mealFoodAt(l, 10) && mealFoodAt(l, 11);
    }

    function mealFreeAt(l, i) {
      return l.size() <= i ||
        (l[i] is string && l[i].trim().size() >= 1 && l[i].size() <= 40);
    }

    function mealFreeFoods(l) {
      return l is list && l.size() <= 3 && mealFreeAt(l, 0) && mealFreeAt(l, 1) && mealFreeAt(l, 2);
    }

    // "Vài thìa · ½ chén · 1 chén" or "Tự nhập": a number and a unit; or not said.
    function validMealAmount(a) {
      return a == null ||
        (a is map && a.keys().hasOnly(['preset']) && a.keys().hasAll(['preset']) &&
          a.preset in ['fewSpoons', 'halfBowl', 'fullBowl']) ||
        (a is map && a.keys().hasOnly(['value', 'unit']) && a.keys().hasAll(['value', 'unit']) &&
          (a.value is int || a.value is float) && a.value > 0 && a.value <= 1000 &&
          a.unit in ['spoon', 'bowl', 'ml', 'g']);
    }

    // When (never in the future: 5 min of clock skew, G-021), what, how much, how it went.
    function validMealBody(d, babyId) {
      return notFuture(d.occurredAt) &&
        d.slot in ['morning', 'noon', 'afternoon', 'evening', 'snack'] &&
        d.dish is string && d.dish.size() <= 60 &&
        mealFoodIds(d.foodIds) && mealFreeFoods(d.freeFoods) &&
        // A dish or at least one ingredient (5c).
        (d.dish.trim().size() > 0 || d.foodIds.size() > 0 || d.freeFoods.size() > 0) &&
        validMealAmount(d.amount) &&
        d.reaction in [null, 'liked', 'neutral', 'notYet'] &&
        d.symptoms is list && d.symptoms.size() <= 7 &&
        d.symptoms.hasOnly(['rash', 'vomit', 'diarrhea', 'fussy', 'swelling', 'breathing',
          'other']) &&
        d.note is string && d.note.size() <= 300 &&
        // A Child Life recipe (`rcp_…`) or one of the family's own (`fr_…`, D-086).
        (d.recipeId == null || (d.recipeId is string &&
          d.recipeId.matches('^(rcp_[a-z0-9_]{2,40}|fr_[a-f0-9]{32})$'))) &&
        // The meal's photo (D-085 #2) lives under this baby's meals in Storage.
        (d.photoPath == null || (d.photoPath is string &&
          d.photoPath.matches('^babies/' + babyId + '/meals/[A-Za-z0-9_-]{8,64}[.]jpg$')));
    }

    function validNewMeal(babyId, mealId) {
      let d = request.resource.data;
      let me = get(memberDoc(babyId)).data;
      return d.keys().hasOnly(mealFields()) && d.keys().hasAll(mealFields()) &&
        mealId.matches('^m_[a-f0-9]{32}$') && d.id == mealId && d.babyId == babyId &&
        d.createdBy == request.auth.uid && d.updatedBy == request.auth.uid &&
        d.createdAt == request.time && d.updatedAt == request.time &&
        d.clientCreatedAt is timestamp &&
        d.deleted == false && d.deletedAt == null && d.deletedBy == null &&
        // "Mẹ ghi" / "Cô Lan ghi" (D-024): the writer's own membership.
        ownAuthor(d.author, me) &&
        validMealBody(d, babyId);
    }

    // As `validRecordUpdate`: who, which baby and when it was made never change.
    function validMealUpdate(babyId) {
      let d = request.resource.data;
      let o = resource.data;
      let changed = d.diff(o).affectedKeys();
      let deleteKeys = ['deleted', 'deletedAt', 'deletedBy', 'updatedAt', 'updatedBy'];
      return d.updatedBy == request.auth.uid && d.updatedAt == request.time && (
        // "Sửa": the meal's details only.
        (o.deleted == false && d.deleted == false &&
          changed.hasOnly(['occurredAt', 'slot', 'dish', 'foodIds', 'freeFoods', 'amount',
            'reaction', 'symptoms', 'note', 'recipeId', 'photoPath', 'updatedAt', 'updatedBy']) &&
          validMealBody(d, babyId)) ||
        // "Xoá" → soft delete.
        (o.deleted == false && d.deleted == true && changed.hasOnly(deleteKeys) &&
          d.deletedAt == request.time && d.deletedBy == request.auth.uid) ||
        // "Hoàn tác" or restore from "Đã xoá gần đây".
        (o.deleted == true && d.deleted == false && changed.hasOnly(deleteKeys) &&
          d.deletedAt == null && d.deletedBy == null)
      );
    }

    // ---------- Công thức nhà mình (D-086; `familyRecipeSchema`) ----------

    function familyRecipeFields() {
      return ['id', 'babyId', 'title', 'photoPath', 'ingredients', 'steps', 'note', 'createdBy',
        'author', 'createdAt', 'clientCreatedAt', 'updatedAt', 'updatedBy', 'deleted', 'deletedAt',
        'deletedBy'];
    }

    // Each element read costs expressions against the 1000-per-request budget (a parameter is
    // re-read from `request.resource.data` at every use), so 15 ingredients and 12 steps cannot be
    // checked field by field. Ingredients: exactly the four keys and a name of 1–40 characters once
    // trimmed (as the contract); the food id, quantity and unit are not checked here (the app reads
    // them defensively). Steps: checked whole, each 1–300 characters and none blank.
    function familyIngredient(x) {
      return x.keys().toSet() == ['foodId', 'name', 'qty', 'unit'].toSet() &&
        x.name.trim().matches('(?s).{1,40}');
    }

    // An index past the end errors, and `|| l.size() <= i` turns that into "nothing to check";
    // a present element is checked without reading the size.
    function familyIngredientAt(l, i) {
      return familyIngredient(l[i]) || l.size() <= i;
    }

    function familyIngredients(l) {
      return l is list && l.size() >= 1 && l.size() <= 15 &&
        familyIngredientAt(l, 0) && familyIngredientAt(l, 1) && familyIngredientAt(l, 2) &&
        familyIngredientAt(l, 3) && familyIngredientAt(l, 4) && familyIngredientAt(l, 5) &&
        familyIngredientAt(l, 6) && familyIngredientAt(l, 7) && familyIngredientAt(l, 8) &&
        familyIngredientAt(l, 9) && familyIngredientAt(l, 10) && familyIngredientAt(l, 11) &&
        familyIngredientAt(l, 12) && familyIngredientAt(l, 13) && familyIngredientAt(l, 14);
    }

    // Up to 12 steps in one go: joined on U+001F and split back, the list comes back equal only if
    // every step is a string without that character; then each is 1–300 characters and none is
    // blank.
    function familySteps(l) {
      return l is list && l.size() <= 12 && (l.size() == 0 || (
        l.join('\u001f').split('\\x1f') == l &&
        l.join('\u001f').matches('(?s)[^\\x1f]{1,300}(\\x1f[^\\x1f]{1,300}){0,11}') &&
        !l.join('\u001f').matches('(?s)(.*\\x1f)?\\s*(\\x1f.*)?')));
    }

    // Title, photo, ingredients, steps, note. The photo is the recipe's own, under this baby's
    // recipes in Storage (never a meal's: the bin purges each with its own document).
    function validFamilyRecipeBody(d, babyId) {
      return d.title is string && d.title.trim().size() >= 1 && d.title.size() <= 60 &&
        familyIngredients(d.ingredients) && familySteps(d.steps) &&
        d.note is string && d.note.size() <= 300 &&
        (d.photoPath == null || (d.photoPath is string && d.photoPath.size() <= 200 &&
          d.photoPath.matches('^babies/' + babyId + '/recipes/[A-Za-z0-9_-]{8,64}[.]jpg$')));
    }

    function validNewFamilyRecipe(babyId, recipeId) {
      let d = request.resource.data;
      let me = get(memberDoc(babyId)).data;
      return d.keys().hasOnly(familyRecipeFields()) && d.keys().hasAll(familyRecipeFields()) &&
        recipeId.matches('^fr_[a-f0-9]{32}$') && d.id == recipeId && d.babyId == babyId &&
        d.createdBy == request.auth.uid && d.updatedBy == request.auth.uid &&
        d.createdAt == request.time && d.updatedAt == request.time &&
        d.clientCreatedAt is timestamp &&
        d.deleted == false && d.deletedAt == null && d.deletedBy == null &&
        ownAuthor(d.author, me) &&
        validFamilyRecipeBody(d, babyId);
    }

    // As `validMealUpdate`: who, which baby and when it was made never change.
    function validFamilyRecipeUpdate(babyId) {
      let d = request.resource.data;
      let o = resource.data;
      let changed = d.diff(o).affectedKeys();
      let deleteKeys = ['deleted', 'deletedAt', 'deletedBy', 'updatedAt', 'updatedBy'];
      return d.updatedBy == request.auth.uid && d.updatedAt == request.time && (
        // "Sửa": the recipe's content only.
        (o.deleted == false && d.deleted == false &&
          changed.hasOnly(['title', 'photoPath', 'ingredients', 'steps', 'note', 'updatedAt',
            'updatedBy']) &&
          validFamilyRecipeBody(d, babyId)) ||
        // "Xoá" → soft delete.
        (o.deleted == false && d.deleted == true && changed.hasOnly(deleteKeys) &&
          d.deletedAt == request.time && d.deletedBy == request.auth.uid) ||
        // "Hoàn tác" or restore from "Đã xoá gần đây".
        (o.deleted == true && d.deleted == false && changed.hasOnly(deleteKeys) &&
          d.deletedAt == null && d.deletedBy == null)
      );
    }

    // ---------- Chi tiêu (D-055, P-140) ----------

    // A member's 8l right; extraRights is null for roles that never had one.
    function spendRight(babyId, key) {
      let x = get(memberDoc(babyId)).data.get('extraRights', null);
      return x != null && x.get(key, false) == true;
    }

    function spendingParent(babyId) {
      return activeMember(babyId) && role(babyId) == 'coParent';
    }

    function canViewSpending(babyId) {
      return activeMember(babyId) &&
        (role(babyId) == 'coParent' || spendRight(babyId, 'viewSpending'));
    }

    function canRecordSpending(babyId) {
      return activeMember(babyId) &&
        (role(babyId) == 'coParent' || spendRight(babyId, 'recordSpending'));
    }

    function familyBabies(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)).data.babyIds;
    }

    // A Cùng nuôi of one of the family's babies (at most 3, maxOwnedBabies).
    function spendingManagerOf(familyId) {
      let ids = familyBabies(familyId);
      return (ids.size() > 0 && spendingParent(ids[0])) ||
        (ids.size() > 1 && spendingParent(ids[1])) ||
        (ids.size() > 2 && spendingParent(ids[2]));
    }

    // Anyone who may see or record spending for one of them.
    function spendingReaderOf(familyId) {
      let ids = familyBabies(familyId);
      return (ids.size() > 0 && spendsOn(ids[0])) ||
        (ids.size() > 1 && spendsOn(ids[1])) ||
        (ids.size() > 2 && spendsOn(ids[2]));
    }

    function spendsOn(babyId) {
      return canViewSpending(babyId) || canRecordSpending(babyId);
    }

    function isoDay(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function categoryRef(v) {
      return v is string && v.matches('^c_[a-z0-9]{3,20}$');
    }

    // "Ai trả" (D-056): a member's label snapshot, or null for "Khác".
    function validPayer(p) {
      return p == null || (p is map &&
        p.keys().hasOnly(['uid', 'name', 'relation', 'relationCustom']) &&
        p.keys().hasAll(['uid', 'name', 'relation', 'relationCustom']) &&
        p.uid is string && p.uid.size() <= 128 &&
        p.name is string && p.name.size() >= 1 && p.name.size() <= 40 &&
        p.relation is string && p.relation.size() <= 24 &&
        (p.relationCustom == null || (p.relationCustom is string && p.relationCustom.size() <= 24)));
    }

    // ---- Chi tiêu currencies (D-075 #4; contracts `currencyInfo`, keep in step) ----
    // Each currency's ceiling in minor units (VND đồng, USD cents, JPY yen).
    function currencyMax() {
      return {'VND': 1000000000, 'USD': 100000000, 'EUR': 100000000, 'GBP': 100000000,
        'AUD': 200000000, 'CAD': 200000000, 'NZD': 200000000, 'SGD': 200000000,
        'JPY': 200000000, 'KRW': 2000000000, 'TWD': 5000000000, 'THB': 5000000000,
        'HKD': 1000000000, 'CNY': 1000000000, 'CHF': 100000000, 'MYR': 500000000};
    }

    // A document without `currency` is VND (old apps keep writing it that way).
    function currencyOf(d) {
      return d.get('currency', 'VND');
    }

    function validCurrency(d) {
      return currencyOf(d) is string && currencyOf(d) in currencyMax();
    }

    // 1 … the ceiling of the document's currency.
    function amountFits(v, d) {
      return validCurrency(d) && intIn(v, 1, currencyMax()[currencyOf(d)]);
    }

    function validSpendingSettings() {
      let d = request.resource.data;
      return d.keys().hasOnly(['currency', 'updatedAt', 'updatedBy']) &&
        d.keys().hasAll(['currency', 'updatedAt', 'updatedBy']) &&
        d.currency is string && d.currency in currencyMax() &&
        d.updatedBy == request.auth.uid && d.updatedAt == request.time;
    }
    // ---- end Chi tiêu currencies ----

    function validExpenseBody(babyId, d) {
      return amountFits(d.amount, d) && categoryRef(d.categoryId) &&
        d.note is string && d.note.size() <= 80 && isoDay(d.spentOn) && validPayer(d.payer) &&
        (d.receiptPath == null || (d.receiptPath is string &&
          d.receiptPath.matches('^babies/' + babyId + '/expenses/[A-Za-z0-9_-]{8,64}[.]jpg$')));
    }

    function validNewExpense(babyId, expenseId) {
      let d = request.resource.data;
      let keys = ['amount', 'categoryId', 'note', 'spentOn', 'payer', 'receiptPath', 'source',
        'sourceRef', 'createdBy', 'author', 'createdAt', 'updatedAt', 'updatedBy', 'deleted',
        'deletedAt', 'deletedBy'];
      // `currency` is optional (D-075 #4): absent = VND, as old apps write it.
      return d.keys().hasOnly(keys.concat(['currency'])) && d.keys().hasAll(keys) &&
        expenseId.matches('^x_[a-f0-9]{32}$') &&
        d.createdBy == request.auth.uid && d.updatedBy == request.auth.uid &&
        d.createdAt == request.time && d.updatedAt == request.time &&
        d.deleted == false && d.deletedAt == null && d.deletedBy == null &&
        // Recurring occurrences come from Functions only (D-057).
        ((d.source == 'manual' && d.sourceRef == null) ||
          (d.source == 'vaccine' && d.sourceRef is string &&
            d.sourceRef.matches('^[a-z0-9]{2,12}_[1-9][0-9]?$'))) &&
        ownAuthor(d.author, get(memberDoc(babyId)).data) &&
        validExpenseBody(babyId, d);
    }

    // Edit, soft delete ("Xoá khoản chi", 8g) and its undo; who and where it came from stay.
    function validExpenseUpdate(babyId) {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['amount', 'currency', 'categoryId',
          'note', 'spentOn', 'payer', 'receiptPath', 'updatedAt', 'updatedBy', 'deleted',
          'deletedAt', 'deletedBy']) &&
        d.updatedBy == request.auth.uid && d.updatedAt == request.time &&
        d.deleted is bool &&
        (d.deleted == resource.data.deleted ||
          (d.deleted && d.deletedAt == request.time && d.deletedBy == request.auth.uid) ||
          (!d.deleted && d.deletedAt == null && d.deletedBy == null)) &&
        validExpenseBody(babyId, d);
    }

    // 8h. `alertedMonth` belongs to the 80 % alert (Functions).
    function validBudget() {
      let d = request.resource.data;
      let before = resource == null ? null : resource.data.get('alertedMonth', null);
      // `currency` (D-075 #4): what the budget counts; absent = VND.
      return d.keys().hasOnly(['monthlyTotal', 'caps', 'alert80', 'updatedAt', 'updatedBy',
          'alertedMonth', 'currency']) &&
        d.keys().hasAll(['monthlyTotal', 'caps', 'alert80', 'updatedAt', 'updatedBy']) &&
        validCurrency(d) &&
        (d.monthlyTotal == null || intIn(d.monthlyTotal, 0, currencyMax()[currencyOf(d)])) &&
        d.caps is map && d.caps.size() <= 60 && d.alert80 is bool &&
        d.updatedBy == request.auth.uid && d.updatedAt == request.time &&
        d.get('alertedMonth', null) == before;
    }

    function validSchedule(s) {
      return s is map && (
        (s.kind == 'monthly' && s.keys().hasOnly(['kind', 'days']) && s.days is list &&
          s.days.size() >= 1 && s.days.size() <= 2 && intIn(s.days[0], 1, 31) &&
          (s.days.size() == 1 || intIn(s.days[1], 1, 31))) ||
        (s.kind == 'weeks' && s.keys().hasOnly(['kind', 'every', 'startOn']) &&
          s.keys().hasAll(['kind', 'every', 'startOn']) && intIn(s.every, 1, 8) &&
          isoDay(s.startOn)) ||
        (s.kind == 'yearly' && s.keys().hasOnly(['kind', 'month', 'day']) &&
          s.keys().hasAll(['kind', 'month', 'day']) && intIn(s.month, 1, 12) &&
          intIn(s.day, 1, 31)));
    }

    function validRecurringBody(d) {
      return d.title is string && d.title.size() >= 1 && d.title.size() <= 60 &&
        categoryRef(d.categoryId) && amountFits(d.amount, d) && validPayer(d.payer) &&
        validSchedule(d.schedule) && d.enabled is bool;
    }

    function validNewRecurring(babyId, recurringId) {
      let d = request.resource.data;
      let keys = ['title', 'categoryId', 'amount', 'payer', 'schedule', 'enabled', 'createdBy',
        'author', 'createdAt', 'updatedAt', 'updatedBy'];
      // `lastOn` only from 8c "Lặp lại hằng tháng": that day's expense is already recorded.
      return d.keys().hasOnly(keys.concat(['lastOn', 'currency'])) && d.keys().hasAll(keys) &&
        (!('lastOn' in d) || isoDay(d.lastOn)) &&
        recurringId.matches('^rx_[a-f0-9]{32}$') &&
        d.createdBy == request.auth.uid && d.updatedBy == request.auth.uid &&
        d.createdAt == request.time && d.updatedAt == request.time &&
        ownAuthor(d.author, get(memberDoc(babyId)).data) && validRecurringBody(d);
    }

    // `lastOn` belongs to the daily job.
    function validRecurringUpdate() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['title', 'categoryId', 'amount',
          'currency', 'payer', 'schedule', 'enabled', 'updatedAt', 'updatedBy']) &&
        d.updatedBy == request.auth.uid && d.updatedAt == request.time && validRecurringBody(d);
    }

    function validCategoryBody(categoryId, d) {
      return d.keys().hasOnly(['name', 'icon', 'tint', 'order', 'hidden', 'builtIn',
          'updatedAt', 'updatedBy']) &&
        d.keys().hasAll(['name', 'icon', 'tint', 'order', 'hidden', 'builtIn', 'updatedAt',
          'updatedBy']) &&
        (d.name == null || (d.name is string && d.name.size() >= 1 && d.name.size() <= 24)) &&
        d.icon in ['family', 'feed', 'diaper', 'heart', 'star', 'journal', 'grid', 'spark',
          'sleep', 'ruler', 'camera', 'cake', 'bell', 'globe', 'today', 'drop'] &&
        d.tint in ['growth', 'bottle', 'diaper', 'pump', 'breast', 'sleep', 'sunshine', 'mint'] &&
        intIn(d.order, 0, 1000) && d.hidden is bool &&
        // "Khác" always stays (8m "không xoá được").
        (categoryId != 'c_other' || d.hidden == false) &&
        d.updatedBy == request.auth.uid && d.updatedAt == request.time;
    }

    function validNewCategory(categoryId) {
      let d = request.resource.data;
      let builtIn = categoryId in ['c_childcare', 'c_milk', 'c_diaper', 'c_health', 'c_clothes',
        'c_other'];
      return validCategoryBody(categoryId, d) && d.builtIn == builtIn &&
        (builtIn || (categoryId.matches('^c_[a-f0-9]{20}$') && d.name != null));
    }

    function validCategoryUpdate(categoryId) {
      let d = request.resource.data;
      return validCategoryBody(categoryId, d) && d.builtIn == resource.data.builtIn &&
        (d.builtIn || d.name != null);
    }

    function ownAuthor(a, me) {
      return a is map && a.keys().hasOnly(['name', 'relation', 'relationCustom']) &&
        a.name == me.displayName && a.relation == me.relation &&
        a.relationCustom == me.get('relationCustom', null);
    }

    // "iPhone của Mai": only ever the writer's own device (D-029).
    function ownDevice(n, me) {
      return n == null || (n is map && n.keys().hasOnly(['id', 'uid', 'label', 'owner']) &&
        n.keys().hasAll(['id', 'uid', 'label', 'owner']) &&
        n.id is string && n.id.matches('^d_[a-f0-9]{32}$') &&
        n.uid == request.auth.uid && n.label is string && n.label.size() >= 1 &&
        n.label.size() <= 40 && n.owner == me.displayName);
    }

    // Shapes mirror packages/contracts/src/reminders.ts. The due time is never in the past when
    // it is set (D-031, 5 min of clock skew) and at most a year ahead.
    function validReminderFields(d, dueChanged) {
      return d.title is string && d.title.size() >= 1 && d.title.size() <= 80 &&
        d.title.trim().size() >= 1 &&
        d.dueAt is timestamp && d.dueAt <= request.time + duration.value(366, 'd') &&
        (!dueChanged || d.dueAt >= request.time - duration.value(5, 'm')) &&
        d.leadMinutes in [0, 10, 30, 60, 120, 1440] &&
        validReminderDay(d);
    }

    // ---- D-075 #5: date-only (all day) and an assignee (docs/product/reminders-allday-
    // assignee-plan.md). Optional keys: absent `allDay` = timed, absent `assigneeUid` = nobody,
    // so older apps and documents are unaffected.
    function validReminderDay(d) {
      return (d.get('allDay', false) == false && d.get('dueDate', null) == null) ||
        (d.get('allDay', false) == true && d.get('dueDate', null) is string &&
          d.dueDate.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$') &&
          d.leadMinutes in [0, 1440] && allDayDueMatches(d));
    }

    // `dueAt` of an all-day reminder is 23:59 on `dueDate` in the baby's zone: between 09:59 and
    // 11:59 the next day in UTC for zones UTC−12 … UTC+14. `timestamp.date` refuses 31/11.
    function allDayDueMatches(d) {
      let p = d.dueDate.split('-');
      let day = timestamp.date(int(p[0]), int(p[1]), int(p[2]));
      return d.dueAt >= day + duration.value(9, 'h') && d.dueAt <= day + duration.value(36, 'h');
    }

    // The assignee: an active Cùng nuôi or Người chăm sóc of the baby (the roles that see
    // reminders, D-018), or nobody.
    function validReminderAssignee(babyId, d) {
      let a = d.get('assigneeUid', null);
      return a == null || (a is string && a.size() >= 1 && a.size() <= 128 &&
        exists(/databases/$(database)/documents/babies/$(babyId)/members/$(a)) &&
        isActive(get(/databases/$(database)/documents/babies/$(babyId)/members/$(a)).data) &&
        get(/databases/$(database)/documents/babies/$(babyId)/members/$(a)).data.role in
          ['coParent', 'caregiver']);
    }
    // ---- end D-075 #5 ----

    function validNewReminder(babyId, reminderId) {
      let d = request.resource.data;
      let me = get(memberDoc(babyId)).data;
      return d.keys().hasOnly(['id', 'babyId', 'title', 'dueAt', 'leadMinutes', 'notifyDevice',
          'createdBy', 'author', 'createdAt', 'updatedAt', 'updatedBy', 'done', 'doneAt',
          'doneBy', 'doneAuthor', 'allDay', 'dueDate', 'assigneeUid']) &&
        d.keys().hasAll(['id', 'babyId', 'title', 'dueAt', 'leadMinutes', 'notifyDevice',
          'createdBy', 'author', 'createdAt', 'updatedAt', 'updatedBy', 'done', 'doneAt',
          'doneBy', 'doneAuthor']) &&
        reminderId.matches('^rm_[a-f0-9]{32}$') && d.id == reminderId && d.babyId == babyId &&
        d.createdBy == request.auth.uid && d.updatedBy == request.auth.uid &&
        d.createdAt == request.time && d.updatedAt == request.time &&
        d.done == false && d.doneAt == null && d.doneBy == null && d.doneAuthor == null &&
        ownAuthor(d.author, me) && ownDevice(d.notifyDevice, me) &&
        validReminderFields(d, true) && validReminderAssignee(babyId, d);
    }

    function validReminderUpdate(babyId) {
      let d = request.resource.data;
      let o = resource.data;
      let me = get(memberDoc(babyId)).data;
      let changed = d.diff(o).affectedKeys();
      let doneKeys = ['done', 'doneAt', 'doneBy', 'doneAuthor', 'updatedAt', 'updatedBy'];
      return d.updatedBy == request.auth.uid && d.updatedAt == request.time && (
        // "Sửa nhắc việc": Cùng nuôi only (D-031), incl. all day and the assignee (D-075 #5).
        (role(babyId) == 'coParent' &&
          changed.hasOnly(['title', 'dueAt', 'leadMinutes', 'notifyDevice', 'updatedAt',
            'updatedBy', 'allDay', 'dueDate', 'assigneeUid']) &&
          (!changed.hasAny(['notifyDevice']) || ownDevice(d.notifyDevice, me)) &&
          (!changed.hasAny(['assigneeUid']) || validReminderAssignee(babyId, d)) &&
          validReminderFields(d, changed.hasAny(['dueAt', 'dueDate', 'allDay']))) ||
        // "Thông báo" → this device (D-029).
        (changed.hasOnly(['notifyDevice', 'updatedAt', 'updatedBy']) &&
          d.notifyDevice != null && ownDevice(d.notifyDevice, me)) ||
        // "Đánh dấu đã xong" (8e, 12f).
        (o.done == false && d.done == true && changed.hasOnly(doneKeys) &&
          d.doneAt == request.time && d.doneBy == request.auth.uid &&
          ownAuthor(d.doneAuthor, me)) ||
        // Undo (D-030): any Cùng nuôi, or whoever marked it.
        (o.done == true && d.done == false && changed.hasOnly(doneKeys) &&
          d.doneAt == null && d.doneBy == null && d.doneAuthor == null &&
          (role(babyId) == 'coParent' || o.doneBy == request.auth.uid))
      );
    }

    // "My babies": collection-group query on members where uid == me (any status, so the app
    // can show "Bạn không còn quyền xem hồ sơ này", R-025).
    match /{path=**}/members/{uid} {
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
