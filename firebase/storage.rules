rules_version = '2';

// Deny by default. Memories (S9): the uploader writes raw bytes only into the slot their upload
// session reserved; Functions process them into `media/` (P-031, P-033). Reads go through these
// Rules with the same audience checks as Firestore (D-002, P-035, R-119); caregivers never see
// Kỷ niệm. Avatars and everything else stay Functions-only.
service firebase.storage {
  match /b/{bucket}/o {
    function member(babyId) {
      return firestore.get(/databases/(default)/documents/babies/$(babyId)/members/$(request.auth.uid)).data;
    }

    function active(m) {
      return m.status == 'active' &&
        (m.get('accessUntilAt', null) == null || m.accessUntilAt > request.time);
    }

    function media(babyId, mediaId) {
      return firestore.get(/databases/(default)/documents/babies/$(babyId)/media/$(mediaId)).data;
    }

    // The raw item ("med_…") or its video poster ("med_….poster"), once, while reserved.
    match /babies/{babyId}/uploads/{file} {
      allow create: if request.auth != null &&
        file.matches('^med_[a-f0-9]{32}([.]poster)?$') &&
        uploadAllowed(babyId, file.split('[.]')[0], file.matches('.*[.]poster$'));
      allow read, update, delete: if false;
    }

    // Storage Rules may read at most TWO Firestore documents per request (media + member here);
    // a baby being deleted is refused by createMemorySession and processUpload instead.
    function uploadAllowed(babyId, mediaId, isPoster) {
      let m = media(babyId, mediaId);
      let me = member(babyId);
      return m.createdBy == request.auth.uid && m.status == 'uploading' && m.deleted == false &&
        active(me) && me.role == 'coParent' &&
        ((isPoster && m.type == 'video' && m.hasPoster == true &&
            request.resource.contentType == 'image/jpeg' &&
            request.resource.size <= 4 * 1024 * 1024) ||
          (!isPoster && request.resource.size <= m.sizeBytes &&
            request.resource.contentType == m.contentType));
    }

    match /babies/{babyId}/media/{mediaId}/{variant} {
      allow read: if request.auth != null && canSee(babyId, mediaId);
      allow write: if false;
    }

    function canSee(babyId, mediaId) {
      let me = member(babyId);
      return active(me) &&
        (me.role == 'coParent' || (me.role == 'relative' && shared(media(babyId, mediaId))));
    }

    function shared(m) {
      return m.effectiveAudience == 'family' && m.status == 'ready' && m.deleted == false;
    }

    // Sổ tiêm chủng photos of the book / slip (VX 0, VX 3, VX 6; P-133): Cùng nuôi and Người
    // chăm sóc add a JPEG up to 4 MB; whoever reads care reads them; Cùng nuôi remove them.
    // Never shown in Kỷ niệm, story links or exports.
    match /babies/{babyId}/vaccines/{file} {
      allow read: if request.auth != null && readsCare(member(babyId));
      allow create: if request.auth != null && file.matches('^[A-Za-z0-9_-]{8,64}[.]jpg$') &&
        logsCare(member(babyId)) && request.resource.contentType == 'image/jpeg' &&
        request.resource.size <= 4 * 1024 * 1024;
      allow delete: if request.auth != null && active(member(babyId)) &&
        member(babyId).role == 'coParent';
      allow update: if false;
    }

    // Bữa ăn dặm photos (5c, D-085 #2): one per meal, like the vaccine book photos. Cùng nuôi and
    // Người chăm sóc add a JPEG up to 4 MB; whoever reads care reads them; Cùng nuôi remove them
    // (the meal's writer is not checkable here). The 30-day bin job removes a purged meal's photo.
    // Never shown in Kỷ niệm, story links or exports.
    match /babies/{babyId}/meals/{file} {
      allow read: if request.auth != null && readsCare(member(babyId));
      allow create: if request.auth != null && file.matches('^[A-Za-z0-9_-]{8,64}[.]jpg$') &&
        logsCare(member(babyId)) && request.resource.contentType == 'image/jpeg' &&
        request.resource.size <= 4 * 1024 * 1024;
      allow delete: if request.auth != null && active(member(babyId)) &&
        member(babyId).role == 'coParent';
      allow update: if false;
    }

    // Công thức nhà mình photos (D-086, plan §12 #2): one per family recipe, exactly like meal
    // photos. Cùng nuôi and Người chăm sóc add a JPEG up to 4 MB; whoever reads care reads them;
    // Cùng nuôi remove them (the recipe's writer is not checkable here). The 30-day bin job removes
    // a purged recipe's photo. Never shown in Kỷ niệm, story links or exports.
    match /babies/{babyId}/recipes/{file} {
      allow read: if request.auth != null && readsCare(member(babyId));
      allow create: if request.auth != null && file.matches('^[A-Za-z0-9_-]{8,64}[.]jpg$') &&
        logsCare(member(babyId)) && request.resource.contentType == 'image/jpeg' &&
        request.resource.size <= 4 * 1024 * 1024;
      allow delete: if request.auth != null && active(member(babyId)) &&
        member(babyId).role == 'coParent';
      allow update: if false;
    }

    // Chi tiêu receipts ("Ảnh hoá đơn", 8c / 8g, P-140): whoever may record or see spending adds and
    // reads them (a recorder only learns the paths of their own items); Cùng nuôi remove them.
    // Never in Kỷ niệm, story links or the CSV.
    match /babies/{babyId}/expenses/{file} {
      allow read: if request.auth != null && spends(member(babyId));
      allow create: if request.auth != null && file.matches('^[A-Za-z0-9_-]{8,64}[.]jpg$') &&
        spends(member(babyId)) && request.resource.contentType == 'image/jpeg' &&
        request.resource.size <= 4 * 1024 * 1024;
      allow delete: if request.auth != null && active(member(babyId)) &&
        member(babyId).role == 'coParent';
      allow update: if false;
    }

    function spends(m) {
      return active(m) && (m.role == 'coParent' ||
        (m.get('extraRights', null) != null &&
          (m.extraRights.get('viewSpending', false) == true ||
            m.extraRights.get('recordSpending', false) == true)));
    }

    function readsCare(m) {
      return active(m) && (m.role in ['coParent', 'caregiver'] ||
        m.get('extraRights', {}).get('viewDailyCare', false) == true);
    }

    function logsCare(m) {
      return active(m) && m.role in ['coParent', 'caregiver'];
    }

    // Sơ cứu (D-058): the published guide's pictures, public like the guide itself. Written by
    // Functions only; immutable (a new picture gets a new name).
    match /content/first-aid/{file} {
      allow read: if true;
      allow write: if false;
    }

    // Thư viện chăm bé / Giai đoạn của bé pictures (D-076): editorial, never child media; public
    // like the first-aid pictures. Functions only; immutable (a new picture gets a new name).
    match /content/library/{file} {
      allow read: if true;
      allow write: if false;
    }

    // "Có gì mới" pictures (D-061): public with the release notes; Functions only; immutable.
    match /content/app-update/{file} {
      allow read: if true;
      allow write: if false;
    }

    // Mẫu kỷ niệm artwork and music (D-068 #7): template assets, never child media; public with
    // the catalog in publicConfig/keepsakes. Functions only; immutable (named by content hash).
    match /content/keepsakes/{file} {
      allow read: if true;
      allow write: if false;
    }

    // Large Mẫu kỷ niệm uploads (a template's preview video, music; D-068): a staff member puts the
    // file under their own uid, once; `staffKeepsakesAsset` checks it, stores it under
    // content/keepsakes/ and deletes it. Nobody reads it from a client.
    match /content/keepsakes-incoming/{uid}/{file} {
      allow create: if request.auth != null && request.auth.uid == uid &&
        request.auth.token.get('staff', false) == true && resource == null &&
        file.matches('^[a-z0-9-]{2,60}[.](mp4|mp3|m4a|png|jpg|webp)$') &&
        request.resource.size <= 50 * 1024 * 1024 &&
        request.resource.contentType.matches('^(video/mp4|audio/(mpeg|mp4|x-m4a)|image/(png|jpeg|webp))$');
      allow read, update, delete: if false;
    }

    // Exports (R-187, P-123): the requester only, until the link expires, and only while they
    // still have the right (Cùng nuôi for care; the owner for media) — re-checked at download.
    match /exports/{uid}/{jobId}/{file} {
      allow read: if request.auth != null && request.auth.uid == uid && exportReadable(uid, jobId);
      allow write: if false;
    }

    // Two documents at most (job + member): ownership comes from the member's isOwner.
    function exportReadable(uid, jobId) {
      let job = firestore.get(/databases/(default)/documents/dataJobs/$(jobId)).data;
      let me = member(job.babyId);
      return job.uid == uid && job.state == 'ready' && job.expiresAt > request.time &&
        active(me) && me.role == 'coParent' &&
        (job.exportKind == 'care' || me.get('isOwner', false) == true);
    }

    // Nhập chi tiêu (D-060, P-144): the grid the phone read from a CSV / Excel file (JSON) and
    // the photos for the AI reading. Only the uploader writes, under their own uid; nobody reads
    // them from a client (Functions do), and an upload never replaces one (`resource == null`:
    // the emulator counts an overwrite as a create); Functions delete them after 7 days. No
    // Firestore reads.
    match /imports/{uid}/{file} {
      allow create: if request.auth != null && request.auth.uid == uid && resource == null &&
        file.matches('^im_[a-f0-9]{32}[.]json$') &&
        request.resource.contentType.matches('^application/json(;.*)?$') &&
        request.resource.size <= 12 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow read, update: if false;
    }

    match /imports/{uid}/{importId}/{file} {
      allow create: if request.auth != null && request.auth.uid == uid && resource == null &&
        importId.matches('^im_[a-f0-9]{32}$') && file.matches('^[0-4][.]jpg$') &&
        request.resource.contentType == 'image/jpeg' &&
        request.resource.size <= 4 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow read, update: if false;
    }

    // FB2 "Ảnh chụp màn hình" (D-065): attached to a Góp ý, uploaded by its sender under their
    // own uid with the request id, once; read by Functions and the portal only.
    match /feedback/{uid}/{file} {
      allow create: if request.auth != null && request.auth.uid == uid && resource == null &&
        file.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}[.](jpg|png)$') &&
        request.resource.contentType.matches('^image/(jpeg|png)$') &&
        request.resource.size <= 4 * 1024 * 1024;
      allow read, update, delete: if false;
    }

    // Child Life Assistant photos (slice A3, brief p.14 / p.19): the uploader puts the one photo
    // `createAttachmentUpload` reserved under their own uid, once (`resource == null`), with the
    // declared type, no larger than declared (≤ 8 MB, image allowlist), before the target expires.
    // Nobody reads, replaces or deletes it from a client: Functions validate the bytes, read it
    // for the provider, keep a re-encoded copy with an expense when asked, and delete it.
    // One Firestore read (the attachment document).
    match /assistant/{uid}/{attachmentId} {
      allow create: if request.auth != null && request.auth.uid == uid && resource == null &&
        attachmentId.matches('^at_[a-f0-9]{32}$') &&
        request.resource.size <= 8 * 1024 * 1024 &&
        request.resource.contentType.matches('^image/(jpeg|png|heic|webp)$') &&
        assistantUploadAllowed(uid, attachmentId);
      allow read, update, delete: if false;
    }

    function assistantUploadAllowed(uid, attachmentId) {
      let a = firestore.get(/databases/(default)/documents/assistantAttachments/$(attachmentId)).data;
      return a.ownerUid == uid && a.state == 'uploading' && a.uploadExpiresAt > request.time &&
        request.resource.contentType == a.mime && request.resource.size <= a.bytes;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
