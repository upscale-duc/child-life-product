{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "landing-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "child-life-landing",
        "exec",
        "vite",
        "preview",
        "--mode",
        "dev",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "portal-emulators",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "child-life-portal",
        "exec",
        "vite",
        "--mode",
        "dev",
        "--port",
        "5173",
        "--strictPort"
      ],
      "env": {
        "VITE_CL_EMULATORS": "true"
      },
      "port": 5173
    }
  ]
}
