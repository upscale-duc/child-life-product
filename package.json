{
  "name": "child-life",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "build": "pnpm -r --filter=!child-life-rules-tests run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --filter=!child-life-rules-tests run test",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-child-life \"pnpm --filter child-life-rules-tests run test\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.1",
    "typescript": "6.0.3"
  },
  "type": "module"
}
